-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":1893,"digest":"sha256:08fd87cfff4a72a5f690670eb7a4df729350316bb75927885d2c931becf69786","download_count":0,"created_at":"2026-11-12T15:57:28Z","updated_at":"2026-11-12T15:57:28Z","browser_download_url":"https://github.com/SANSEVIERIA-OU/kalliope/releases/download/v0.1-rc.1/kalliope-bin.PKGBUILD"},{"url":"https://api.github.com/repos/SANSEVIERIA-OU/kalliope/releases/assets/740090581","id":740090581,"node_id":"RA_kwDOVrzwZc4sHOLV","name":"SHA256SUMS","label":"","uploader":{"login":"github-actions[bot]","id":41898282,"node_id":"MDM6Qm90NDE4OTgyODI=","avatar_url":"https://avatars.githubusercontent.com/in/15368?v=4","gravatar_id":"","url":"https://api.github.com/users/github-actions%5Bbot%5D","html_url":"https://github.com/apps/github-actions","followers_url":"https://api.github.com/users/github-actions%5Bbot%5D/followers","following_url":"https://api.github.com/users/github-actions%5Bbot%5D/following{/other_user}","gists_url":"https://api.github.com/users/github-actions%5Bbot%5D/gists{/gist_id}","starred_url":"https://api.github.com/users/github-actions%5Bbot%5D/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/github-actions%5Bbot%5D/subscriptions","organizations_url":"https://api.github.com/users/github-actions%5Bbot%5D/orgs","repos_url":"https://api.github.com/users/github-actions%5Bbot%5D/repos","events_url":"https://api.github.com/users/github-actions%5Bbot%5D/events{/privacy}","received_events_url":"https://api.github.com/users/github-actions%5Bbot%5D/received_events","type":"Bot","user_view_type":"public","site_admin":false},"content_type":"application/octet-stream","state":"uploaded","size":381,"digest":"sha256:799772e565330ce560223e405a75d2900906c7cc98db5c34c9f44cfb680bc57c","download_count":0,"created_at":"2026-11-12T15:57:28Z","updated_at":"2026-11-12T15:57:28Z","browser_download_url":"https://github.com/SANSEVIERIA-OU/kalliope/releases/download/v0.1-rc.1/SHA256SUMS"}],"tarball_url":"https://api.github.com/repos/SANSEVIERIA-OU/kalliope/tarball/v0.1-rc.1","zipball_url":"https://api.github.com/repos/SANSEVIERIA-OU/kalliope/zipball/v0.1-rc.1","body":"The first version, for Linux. Still being finished.\n\n- **The Kalliope window.** Type, press Enter, and Kalliope speaks. Stop cuts it short. The phrases you have said stay in a list, so you can say them again with one click. Choose the voice, Giulia or Marco. \"Senti anche tu\" lets you hear the voice on your own speakers too. The next sentence is prepared while the one before it plays. Screen readers can use the window.\n- **A microphone called \"Kalliope\".** In Zoom, Teams, Meet, Jitsi or the browser, choose \"Kalliope\" as the microphone, and the call hears what you type. It sends sound only while an app is listening, like a real microphone, and costs nothing while nobody is. On Linux it uses PipeWire; Windows and macOS do not have it yet.\n- **The voice is made on your computer.** No text leaves it. The voice is Klein, a natural neural voice, and uses little power: about 0.07 seconds of processor time for each second of speech. Kalliope downloads it (about 53 MB) the first time it starts.\n- **Italian read the way people say it.** Numbers, dates, times, money, units, phone numbers, addresses, abbreviations and acronyms become words. So does chat shorthand: \"cmq ci vediamo dmn alle 10:30\" is read as \"comunque ci vediamo domani alle dieci e trenta\". Missing accents are put back: \"perche\" is read as \"perché\".\n- Punctuation shapes the voice. Questions sound like questions, and commas make short pauses.\n- Kalliope knows how Italian words are pronounced: where the stress falls, and whether an e or an o is open or closed. It uses rules and a list of about 7,900 words, and needs no other program.\n- From a terminal: `kalliope --say TEXT` speaks into the microphone without the window, and `kalliope-cli` turns text into a WAV file or shows how each sentence is pronounced.\n\n## Which file\n\n- **Debian 13, Ubuntu 24.04 or newer:** `kalliope-0.1-rc.1-amd64.deb`. Install it with `sudo apt install ./kalliope-0.1-rc.1-amd64.deb`.\n- **Fedora:** `kalliope-0.1-rc.1-x86_64.rpm`. Install it with `sudo dnf install ./kalliope-0.1-rc.1-x86_64.rpm`.\n- **Other Linux (x86_64):** `kalliope-0.1-rc.1-linux-x86_64.tar.gz`. Unpack it and run `./install`: Kalliope goes into `~/.local`, for you alone. `./install --remove` takes it away again.\n- **Arch Linux:** `kalliope-bin.PKGBUILD`. Save it as `PKGBUILD` next to the `.tar.gz`, then run `makepkg -si`.\n\nThe first time it starts, Kalliope downloads its voice (about 53 MB). It needs `curl` for that, which the packages install.\n\nTo check what you downloaded: `sha256sum -c SHA256SUMS --ignore-missing`.\n"}]