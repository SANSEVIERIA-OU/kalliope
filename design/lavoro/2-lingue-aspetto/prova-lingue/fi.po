#, kalliope-markup
msgctxt "frase.3.detto-riga"
msgid "<1>Detto:</1> «Il preventivo è di milleduecentocinquanta euro più IVA, valido fino al trentuno dicembre.»"
msgstr "<1>Sanottu:</1> ”Tarjous on tuhat kaksisataaviisikymmentä euroa plus ALV, voimassa kolmaskymmenesensimmäinen joulukuuta asti.”"

