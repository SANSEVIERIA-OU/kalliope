msgid "Con la tastiera. Con un lettore di schermo, il puntamento oculare o gli interruttori: <1>non ancora provato</1>."
msgstr "Con la tastiera. Con un lettore di schermo, il puntamento oculare o gli interruttori: <1>non ancora provato</1>."

#: stato/index.html
#, kalliope-markup
