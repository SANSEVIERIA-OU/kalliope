msgid "huggingface.co"
msgstr "huggingface.co"

#: stato/index.html
#, kalliope-markup
msgctxt "st.varco.nome"
msgid "Il tuo computer"
msgstr "Il tuo computer"

#: stato/index.html
#, kalliope-markup
msgctxt "st.varco.finestra"
msgid "Kalliope"
msgstr "Kalliope"

#: stato/index.html
#, kalliope-markup
msgctxt "st.varco.scritto"
msgid "Ci sono anch'io, scusate il ritardo."
msgstr "Ci sono anch'io, scusate il ritardo."

#: stato/index.html
#, kalliope-markup
