msgctxt "st.passo.scarico.testo"
msgid "Al primo avvio Kalliope scarica la voce con il programma curl, da huggingface.co, a una revisione fissata: tre file, 53 MB. Controlla l'impronta SHA-256 di ciascuno e scarta quello che non corrisponde. Poi funziona senza internet. <1><2>download.rs</2>, <3>catalog.rs</3></1>"
msgstr "Al primo avvio Kalliope scarica la voce con il programma curl, da huggingface.co, a una revisione fissata: tre file, 53 MB. Controlla l'impronta SHA-256 di ciascuno e scarta quello che non corrisponde. Poi funziona senza internet. <1><2>download.rs</2>, <3>catalog.rs</3></1>"

