#, kalliope-markup
msgctxt "frase.3.detto-riga"
msgid "<1>Detto:</1> «Il preventivo è di milleduecentocinquanta euro più IVA, valido fino al trentuno dicembre.»"
msgstr "<1>Gesprochen:</1> „Das Angebot beträgt eintausendzweihundertfünfzig Euro plus MwSt., gültig bis zum einunddreißigsten Dezember.“"

#: index.html
#, kalliope-markup
