#, kalliope-markup
msgctxt "riu.testo.21"
msgid "Controlla che ti sentano"
msgstr "Controlla che ti sentano"

#: riunione/index.html
#, kalliope-markup
msgctxt "riu.testo.22"
msgid "Hai tre modi. Il primo è il più semplice, il terzo il più sicuro."
msgstr "Hai tre modi. Il primo è il più semplice, il terzo il più sicuro."

#: riunione/index.html
#, kalliope-markup
msgctxt "riu.testo.23"
msgid "1. La finestra ti avvisa"
msgstr "1. La finestra ti avvisa"

