msgid "<1>Riuscito</1> se, scrivendo <2>kalliope --version</2>, il terminale risponde <3>kalliope {{kalliope.program.version}}</3>."
msgstr "<1>Riuscito</1> se, scrivendo <2>kalliope --version</2>, il terminale risponde <3>kalliope {{kalliope.program.version}}</3>."

