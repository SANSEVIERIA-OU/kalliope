msgstr "<1>Entra in riunione.</1> <2>Con le tue parole.</2>"

#: riunione/index.html
#, kalliope-markup
msgctxt "riu.apertura.testo"
msgid "Apri Kalliope, scegli il suo microfono e fai una prova con qualcuno. Poi scrivi: la voce porta le tue parole nella riunione."
msgstr "Apri Kalliope, scegli il suo microfono e fai una prova con qualcuno. Poi scrivi: la voce porta le tue parole nella riunione."

