msgid "Fin dove arriva la voce, oggi."
msgstr "Wie weit die Stimme heute kommt."

#: index.html
#, kalliope-markup
msgctxt "oggi.testo"
msgid "Detto chiaro, prima di scaricare: che cosa è provato e che cosa no."
msgstr "Klar gesagt, bevor du herunterlädst: was erprobt ist und was nicht."

