msgstr "Kalliope"

#: riunione/index.html
#, kalliope-markup
msgctxt "riu.testo.20"
msgid "Qui puoi provare il menu. Nella riunione, scegli «Kalliope» nelle impostazioni audio dell'app che usi."
msgstr "Qui puoi provare il menu. Nella riunione, scegli «Kalliope» nelle impostazioni audio dell'app che usi."

