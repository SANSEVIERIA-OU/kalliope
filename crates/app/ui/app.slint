// SPDX-License-Identifier: LicenseRef-SANSEVIERIA-1.1
// Kalliope's window: write, press Enter, and the virtual microphone speaks. The look is the direction «La frase che si
// accende» (design/lavoro/4-app/direzione/direzione.md), made of the components in kalliope/ and the values in Token.

import { Token } from "token.slint";
import { Aspetto, Situazione } from "kalliope/aspetto.slint";
import { Finestra, Schermata } from "kalliope/finestra.slint";
export { Catalogo } from "kalliope/catalogo.slint";
import { Creazione, Tratto } from "kalliope/creazione.slint";
export { Situazione, Schermata, Aspetto, Creazione, Tratto }

export enum Phase { loading, ready, speaking, error }

export component AppWindow inherits Window {
    title: "Kalliope";
    icon: @image-url("../../../packaging/linux/io.github.sansevieria_ou.kalliope.svg");
    preferred-width: Token.native-width;
    preferred-height: Token.native-height;
    min-width: Token.native-min-width;
    min-height: Token.native-min-height;
    background: Token.fondo;
    default-font-family: Token.font-testo;
    default-font-size: Token.corpo-comando;
    forward-focus: finestra;
    // the meeting mode keeps the window above the others where the system allows a program to ask for it
    always-on-top: root.compatta;

    in property <Phase> phase: Phase.loading;
    in property <string> status: @tr("programma.finestra.preparo-la-voce" => "Preparo la voce…");
    in property <bool> warning: false;
    // the state the status line shows, from the engine's real flags (session.rs, Status::situation)
    in property <Situazione> situazione:
        root.phase == Phase.loading ? Situazione.preparazione
        : root.phase == Phase.error ? Situazione.problema-voce
        : root.warning ? Situazione.avviso
        : root.phase == Phase.speaking ? Situazione.parla
        : Situazione.pronta;
    in property <[string]> history;
    in property <[string]> voices: ["Giulia", "Marco"];
    in-out property <int> voice-index: 0;
    in-out property <bool> monitor: true;
    in property <string> version: "0.1";
    // the language is written from right to left: the window is mirrored (the program sets it from the language, lingua.rs)
    in-out property <bool> rtl <=> Token.rtl;
    // what the mirror multiplies by (1, or -1 from right to left): for Rust, which tests it
    out property <int> verso: Token.verso;
    in-out property <string> draft;
    in-out property <bool> compatta: false;
    in-out property <Schermata> schermata: Schermata.scrivi;
    in-out property <bool> suggerimento-sopra: true;
    in property <bool> senza-primo-piano: false;
    in property <string> notizia;
    // which words the voice has said (-1: all) and how far the next one has darkened: from the engine's pieces (avanzamento.rs)
    in property <int> dette-vere: -1;
    in property <float> sfumatura-vera: 0;
    // the meeting mode's size, the window's own, and the pace of the words, for Rust (the Token global has easing values
    // Rust cannot see)
    out property <length> compatta-larghezza: Token.compatta-larghezza;
    out property <length> compatta-altezza: Token.compatta-altezza;
    out property <length> nativa-larghezza: Token.native-width;
    out property <length> nativa-altezza: Token.native-height;
    out property <duration> durata-parola: Token.durata-parola;
    out property <duration> durata-scurisce: Token.durata-scurisce;
    out property <duration> intervallo-fotogramma: Token.intervallo-fotogramma;
    out property <float> scala-massima: Token.scala-massima;
    public function scrivi() { finestra.metti-a-fuoco(); }
    public function mostra-informazioni() { finestra.apri-informazioni(); }
    public function mostra-conferma() { finestra.apri-conferma(); }

    pure callback has-speech-text(string) -> bool;
    // the bubble darkens the words one by one: how many words a phrase has, and its beginning up to a number of words
    pure callback conta-parole(string) -> int;
    pure callback prefisso(string, int) -> string;
    // a phrase runs from right to left (its first letter says so): the bubble lays it out that way, whatever the window's language
    pure callback da-destra(string) -> bool;
    callback speak(string) -> bool;
    callback stop();
    callback voice-changed(int);
    callback monitor-changed(bool);
    callback compatta-cambiata(bool);
    callback scala-cambiata(float);
    callback suggerimento-letto();
    callback notizia-chiusa();
    callback apri-crea-voce();
    callback svuota-cronologia();
    callback apri-sito();
    callback apri-guida(Situazione);

    finestra := Finestra {
        x: 0; y: 0; width: root.width; height: root.height;
        // The mirror. Slint has no direction of writing for a layout, so from right to left the whole window is turned round
        // (`Token.verso` is -1) and every Text, TextInput and Image turns itself back (`transform-scale-x: Token.verso`, about its own
        // centre): the places mirror, the letters and the logo do not. Inside a text the letters keep their own direction (Arabic
        // from right to left, a number or a word in Latin from left to right) and the paragraph starts on its own side.
        // tools/slint_valori.py checks that no Text, TextInput or Image of the window forgets it.
        transform-scale-x: Token.verso;
        situazione: root.situazione;
        spiegazione: root.status;
        pronta: root.phase == Phase.ready || root.phase == Phase.speaking;
        parla: root.phase == Phase.speaking;
        history: root.history;
        dette-vere: root.dette-vere;
        sfumatura-vera: root.sfumatura-vera;
        senza-primo-piano: root.senza-primo-piano;
        notizia: root.notizia;
        parole: root.history.length > 0 ? root.conta-parole(root.history[0]) : 0;
        prefisso(t, n) => { return root.prefisso(t, n); }
        da-destra(t) => { return root.da-destra(t); }
        voices: root.voices;
        voice-index <=> root.voice-index;
        monitor <=> root.monitor;
        version: root.version;
        draft <=> root.draft;
        compatta <=> root.compatta;
        schermata <=> root.schermata;
        suggerimento-sopra <=> root.suggerimento-sopra;
        speak(t) => { return root.has-speech-text(t) && root.speak(t); }
        stop => { root.stop(); }
        voice-changed(i) => { root.voice-changed(i); }
        monitor-changed(on) => { root.monitor-changed(on); }
        compatta-cambiata(on) => { root.compatta-cambiata(on); }
        scala-cambiata(f) => { root.scala-cambiata(f); }
        suggerimento-letto => { root.suggerimento-letto(); }
        notizia-chiusa => { root.notizia-chiusa(); }
        apri-crea-voce => { root.apri-crea-voce(); }
        svuota-cronologia => { root.svuota-cronologia(); }
        apri-sito => { root.apri-sito(); }
        apri-guida(s) => { root.apri-guida(s); }
    }
}
