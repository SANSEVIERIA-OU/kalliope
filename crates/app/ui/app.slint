// Kalliope's window: write, press Enter, and the virtual microphone speaks.

import { Button, LineEdit, ComboBox, CheckBox, ListView, AboutSlint, VerticalBox, HorizontalBox, ScrollView, Palette, GroupBox } from "std-widgets.slint";

import { NativeTokens } from "native_tokens.slint";

export enum Phase { loading, ready, speaking, error }

export component AppWindow inherits Window {
    title: "Kalliope";
    icon: @image-url("../../../packaging/linux/io.github.sansevieria_ou.kalliope.svg");
    preferred-width: NativeTokens.window-width;
    preferred-height: NativeTokens.window-height;
    min-width: NativeTokens.min-window-width;
    min-height: NativeTokens.min-window-height;
    background: Palette.background;
    forward-focus: input;

    in property <Phase> phase: Phase.loading;
    in property <string> status: "Preparo la voce…";
    in property <bool> warning: false;
    in property <[string]> history;
    in property <[string]> voices: ["Giulia", "Marco"];
    in-out property <int> voice-index: 0;
    in-out property <bool> monitor: true;
    in property <string> version: "0.1";
    in-out property <string> draft;

    pure callback has-speech-text(string) -> bool;
    callback speak(string) -> bool;
    callback stop();
    callback voice-changed(int);
    callback monitor-changed(bool);

    property <bool> can-speak: root.phase == Phase.ready || root.phase == Phase.speaking;

    main-scroll := ScrollView {
        content-width: self.visible-width;
        content-height: max(self.visible-height, content.min-height);
        content := VerticalBox {
            width: main-scroll.visible-width;
            height: main-scroll.content-height;
            spacing: NativeTokens.spacing;
            padding: NativeTokens.spacing;

            GroupBox {
                title: root.warning ? "Attenzione" : "Stato";
                vertical-stretch: 0;
                status-text := Text {
                    text: root.status;
                    wrap: word-wrap;
                    color: Palette.foreground;
                    min-height: status-lines.preferred-height;
                    accessible-role: text;
                }
            }
            FlexboxLayout {
                flex-wrap: wrap;
                vertical-stretch: 0;
                spacing: NativeTokens.spacing;
                input := LineEdit {
                    preferred-width: NativeTokens.window-width / 2;
                    min-width: 0px;
                    horizontal-stretch: 1;
                    placeholder-text: "Scrivi qui e premi Invio per parlare";
                    text <=> root.draft;
                    accessible-label: "Testo da dire";
                    accepted(text) => {
                        if (root.can-speak && root.has-speech-text(text) && root.speak(text)) {
                            root.draft = "";
                        }
                        input.focus();
                    }
                }
                Button {
                    text: "Parla";
                    primary: true;
                    enabled: root.can-speak && root.has-speech-text(root.draft);
                    clicked => {
                        if (root.speak(root.draft)) {
                            root.draft = "";
                        }
                        input.focus();
                    }
                }
                Button {
                    text: "Ferma";
                    enabled: root.phase == Phase.speaking;
                    clicked => {
                        root.stop();
                        input.focus();
                    }
                }
            }

            Text {
                text: root.history.length > 0 ? "Già detto: scegli una frase per ripeterla" : "Le frasi che dici restano qui, per ripeterle.";
                color: Palette.foreground;
                wrap: word-wrap;
            }

            history-list := ListView {
                vertical-stretch: 1;
                min-height: NativeTokens.spacing * 4;
                for phrase in root.history: HorizontalBox {
                    width: history-list.visible-width;
                    spacing: NativeTokens.spacing;
                    padding: 0px;
                    Text {
                        text: phrase;
                        wrap: word-wrap;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        color: Palette.foreground;
                    }
                    Button {
                        text: "Ripeti";
                        enabled: root.can-speak;
                        accessible-label: "Ripeti: " + phrase;
                        clicked => {
                            root.speak(phrase);
                            input.focus();
                        }
                    }
                }
            }

            FlexboxLayout {
                flex-wrap: wrap;
                vertical-stretch: 0;
                spacing: NativeTokens.spacing;
                HorizontalBox {
                    padding: 0px;
                    spacing: NativeTokens.spacing;
                    preferred-width: NativeTokens.window-width / 3;
                    horizontal-stretch: 1;
                    Text {
                        text: "Voce";
                        color: Palette.foreground;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        model: root.voices;
                        current-index <=> root.voice-index;
                        accessible-label: "Voce";
                        selected => {
                            root.voice-changed(self.current-index);
                        }
                    }
                }
                CheckBox {
                    text: "Senti anche tu";
                    checked <=> root.monitor;
                    toggled => {
                        root.monitor-changed(self.checked);
                    }
                }
                Button {
                    text: "Informazioni";
                    clicked => {
                        about-popup.show();
                    }
                }
            }
        }

    }
    // Measure two lines with the active platform font, independently of status text.
    status-lines := Text { text: "M\nM"; visible: false; }

    about-popup := PopupWindow {
        width: max(root.width, NativeTokens.min-window-width);
        height: max(root.height, NativeTokens.min-window-height);
        close-policy: close-on-click-outside;
        forward-focus: close-about;
        Rectangle {
            background: Palette.background;
            TouchArea {
                clicked => { about-popup.close(); }
            }
            Rectangle {
                x: NativeTokens.spacing;
                y: NativeTokens.spacing;
                // Clicking inside the panel must not reach its dismissing backdrop.
                TouchArea { }
                width: parent.width - 2 * NativeTokens.spacing;
                height: parent.height - 2 * NativeTokens.spacing;
                GroupBox {
                    width: parent.width;
                    height: parent.height;
                    title: "Informazioni";
                    VerticalBox {
                        padding: 0px;
                        spacing: NativeTokens.spacing;
                        about-scroll := ScrollView {
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, about.min-height);
                            about := VerticalBox {
                                width: about-scroll.visible-width;
                                height: about-scroll.content-height;
                                spacing: NativeTokens.spacing;
                                Text {
                                    text: "Kalliope " + root.version;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: "Scrivi e fatti sentire nelle videochiamate. La voce viene creata su questo computer: nessun testo lascia la tua macchina.";
                                    wrap: word-wrap;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: "Guida, aiuto e nuove versioni: sansevieria-ou.github.io/kalliope";
                                    wrap: word-wrap;
                                    color: Palette.foreground;
                                }
                                Text {
                                    text: "© SANSEVIERIA OÜ. Licenza SANSEVIERIA 1.1. Voce: Klein-TTS-X1.5-Pro (Apache-2.0). ONNX Runtime (MIT). Dati di pronuncia da Wiktionary (CC BY-SA 4.0). Pocket TTS di Kyutai (kyutai.org), CC BY 4.0; convertito in ONNX e quantizzato da Kalliope. Fonte, modifiche e licenza nei file share/doc/kalliope/pocket-tts/NOTICE.txt e LICENSE del pacchetto.";
                                    wrap: word-wrap;
                                    color: Palette.foreground;
                                }
                                AboutSlint {
                                    preferred-height: self.min-height;
                                }
                            }
                        }
                        HorizontalBox {
                            padding: 0px;
                            alignment: end;
                            close-about := Button {
                                text: "Chiudi";
                                primary: true;
                                clicked => {
                                    about-popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
