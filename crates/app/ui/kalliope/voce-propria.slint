// Creating one's own voice inside the window: record a short text, or use a recording one already has; listen, name, consent.
import { Token } from "token.slint";
import { Aspetto } from "aspetto.slint";
import { Pulsante, Tipo, Tratteggio, Punto } from "forme.slint";
import { Creazione, Tratto } from "creazione.slint";
import { Avviso, Attesa } from "avvisi.slint";

// Where the person is among the three steps: done, now, next (ElevenLabs IVC shows its steps this way).
export component Passi inherits HorizontalLayout {
    in property <int> passo;
    // a narrow window: only the step one is on, with «n di 3»
    in property <bool> compatti: false;
    // TRANSLATORS: The name of the second step of making a voice (the person reads a text aloud)
    in property <[string]> nomi: [@tr("programma.crea.passo-scegli" => "Registra o importa"), @tr("programma.crea.passo-leggi" => "Leggi ad alta voce"), @tr("programma.crea.passo-nome" => "Ascolta e dai un nome")];
    spacing: Token.spazio-largo * Aspetto.scala;
    if root.compatti: Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
        // TRANSLATORS: Where the person is among the three steps of making a voice: {0} is the number of the step (1 to 3), {1} its name
        text: @tr("programma.crea.passo" => "{} di 3 · {}", root.passo + 1, root.nomi[root.passo]);
        vertical-alignment: center;
        font-size: Token.corpo-stato * Aspetto.scala;
        font-weight: Token.peso-forte;
        color: Token.testo;
    }
    for nome[i] in root.compatti ? [] : root.nomi: HorizontalLayout {
        spacing: Token.spazio-stretto * Aspetto.scala;
        Rectangle {
            width: Token.punto * 1.6 * Aspetto.scala; height: self.width;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: i < root.passo ? Token.azione : transparent;
            border-width: i == root.passo ? Token.tratto : Token.filo;
            border-color: i <= root.passo ? Token.azione : Token.bordo-comando;
        }
        Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
            text: nome;
            vertical-alignment: center;
            font-size: Token.corpo-stato * Aspetto.scala;
            font-weight: i == root.passo ? Token.peso-forte : Token.peso-testo;
            color: i <= root.passo ? Token.testo : Token.testo-spento;
        }
    }
}

// The level of the microphone while recording: the bars of the voice, many and live.
export component Livello inherits Rectangle {
    in property <bool> attivo;
    in property <float> forza: 0.8;
    // not live: the still shape of what was recorded, instead of a row of dots
    in property <bool> forma: false;
    property <int> quante: Token.livello-barre;
    property <length> passo: self.width / self.quante;
    height: Token.livello-altezza * Aspetto.scala;
    for i in root.quante: Rectangle {
        property <float> onda: root.attivo && !Aspetto.movimento-ridotto
            ? root.forza * abs(sin(animation-tick() / Token.durata-barre * 0.37turn + i * 0.61turn)) * (0.35 + 0.65 * abs(sin(animation-tick() / Token.durata-cammino * 0.5turn + i * 0.13turn)))
            : (root.attivo ? root.forza * 0.5 : root.forma ? root.forza * abs(sin(i * 0.61turn)) * (0.35 + 0.65 * abs(sin(i * 0.13turn))) : 0);
        x: i * root.passo + (root.passo - self.width) / 2;
        width: Token.barra-voce * Aspetto.scala;
        height: self.width + (root.height - self.width) * self.onda;
        y: (root.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.attivo ? Token.voce : root.forma ? Token.testo-tenue : Token.bordo-comando;
    }
}

// The round «record» button: the colour of the logo's bubble. While recording, its square says «stop».
export component Registra inherits Rectangle {
    in property <bool> registra;
    // 0 → 1: how much of the useful twelve seconds is recorded; the ring fills around the button
    in property <float> avanzamento: 0;
    // the microphone is opening, or the recording is being checked: the button waits
    in property <bool> occupato: false;
    callback premuto();
    accessible-role: button;
    accessible-label: root.registra ? @tr("programma.crea.ferma-registrazione" => "Ferma la registrazione") : @tr("programma.crea.registra" => "Registra");
    accessible-enabled: !root.occupato;
    accessible-action-default => { if (!root.occupato) { root.premuto(); } }
    forward-focus: chiave;
    opacity: root.occupato ? Token.opacita-spento : 1;
    width: Token.registra-diametro * Aspetto.scala; height: self.width;
    border-radius: self.width / 2;
    border-width: Token.tratto;
    border-color: Token.bordo-comando;
    // the keyboard focus is a ring outside the button, so the ring of the twelve seconds stays visible under it
    Rectangle {
        x: -Token.tratto * 2; y: -Token.tratto * 2;
        width: parent.width + 4 * Token.tratto; height: self.width;
        border-radius: self.width / 2;
        border-width: Token.tratto;
        border-color: chiave.has-focus ? Token.voce : transparent;
    }
    // the ring of the twelve seconds (Apple shows «1 of 150»; here the seconds that are enough)
    if root.avanzamento > 0: Path {
        property <float> a: min(root.avanzamento, 0.9999);
        width: parent.width; height: parent.height;
        viewbox-width: 100; viewbox-height: 100;
        commands: "M 50 1.5 A 48.5 48.5 0 " + (self.a > 0.5 ? "1" : "0") + " 1 " + (50 + 48.5 * sin(self.a * 1turn)) + " " + (50 - 48.5 * cos(self.a * 1turn));
        stroke: root.avanzamento >= 1 ? Token.azione : Token.voce;
        stroke-width: Token.tratto;
        fill: transparent;
    }
    Rectangle {
        width: root.registra ? parent.width * 0.36 : parent.width * 0.62;
        height: self.width;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        border-radius: root.registra ? Token.raggio-coda * Aspetto.scala : self.width / 2;
        background: Token.registra-fisso;
        animate width, border-radius { duration: Token.durata-pannello; easing: Token.curva-entrata; }
    }
    chiave := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { if (!root.occupato) { root.premuto(); } return accept; }
            return reject;
        }
    }
    TouchArea { mouse-cursor: root.occupato ? default : pointer; clicked => { if (!root.occupato) { root.premuto(); } } }
}

// One of the two ways in. The main way is large and shows the record button itself; the second way is a row under it.
component Strada inherits Rectangle {
    in property <string> titolo;
    in property <string> testo;
    in property <string> per-chi;
    in property <bool> principale;
    callback scelta();
    property <bool> sopra: tocco.has-hover || chiave.has-focus;
    accessible-role: button;
    accessible-label: root.titolo;
    accessible-action-default => { root.scelta(); }
    forward-focus: chiave;
    horizontal-stretch: 1;
    min-height: riga.preferred-height;
    border-radius: Token.raggio-pannello * Aspetto.scala;
    background: root.principale ? (root.sopra ? Token.velo-scelto : Token.campo) : (root.sopra ? Token.velo-sopra : transparent);
    border-width: chiave.has-focus ? Token.tratto : (root.principale ? Token.filo : 0);
    border-color: chiave.has-focus ? Token.voce : Token.bordo;
    animate background { duration: Token.durata-scurisce; easing: Token.curva-dolce; }
    riga := HorizontalLayout {
        padding: (root.principale ? Token.spazio-largo : Token.spazio-controlli) * Aspetto.scala;
        spacing: Token.spazio-largo * Aspetto.scala;
        // the sign sits in its own column: the record button, or the dashed sheet of a file
        VerticalLayout { alignment: center;
            if root.principale: Rectangle {
                width: Token.registra-diametro * Aspetto.scala; height: self.width;
                border-radius: self.width / 2; border-width: Token.tratto; border-color: Token.bordo-comando;
                Rectangle { width: parent.width * 0.62; height: self.width; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: self.width / 2; background: Token.registra-fisso; }
            }
            if !root.principale: Rectangle {
                width: Token.altezza-comando * Aspetto.scala; height: self.width;
                Tratteggio {
                    width: parent.width * 0.62; height: parent.height * 0.8; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    raggio: Token.raggio-coda * Aspetto.scala; tratto: Token.tratto; pieno: Token.tratteggio-vuoto * Aspetto.scala * 0.6; vuoto: Token.tratteggio-vuoto * Aspetto.scala * 0.4;
                    colore: Token.azione;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: Token.spazio-minimo * Aspetto.scala;
            horizontal-stretch: 1;
            if root.per-chi != "": Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.per-chi; font-size: Token.corpo-stato * Aspetto.scala; font-weight: Token.peso-forte; color: Token.azione; wrap: word-wrap; }
            Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.titolo; font-size: (root.principale ? Token.corpo-titolo : Token.corpo-comando) * Aspetto.scala; font-weight: root.principale ? Token.peso-titolo : Token.peso-forte; color: Token.testo; wrap: word-wrap; }
            Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.testo; font-size: Token.corpo-stato * Aspetto.scala; color: Token.testo-tenue; wrap: word-wrap; }
        }
    }
    chiave := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.scelta(); return accept; }
            return reject;
        }
    }
    tocco := TouchArea { mouse-cursor: pointer; clicked => { root.scelta(); } }
}

// A box to tick, said with words.
export component Consenso inherits Rectangle {
    in-out property <bool> dato;
    in property <string> testo;
    accessible-role: checkbox;
    accessible-checked: root.dato;
    accessible-label: root.testo;
    accessible-action-default => { root.dato = !root.dato; }
    forward-focus: chiave;
    min-height: riga.preferred-height;
    riga := HorizontalLayout {
        spacing: Token.spazio-controlli * Aspetto.scala;
        alignment: start;
        Rectangle {
            width: Token.spazio-largo * Aspetto.scala; height: self.width;
            border-radius: Token.raggio-coda * Aspetto.scala;
            background: root.dato ? Token.azione : transparent;
            border-width: chiave.has-focus ? Token.tratto : Token.tratto * 0.67;
            border-color: chiave.has-focus ? Token.voce : (root.dato ? Token.azione : Token.bordo-comando);
            Path {
                visible: root.dato;
                width: parent.width * 0.6; height: parent.height * 0.6;
                viewbox-width: 10; viewbox-height: 10;
                commands: "M 1.5 5.2 L 4 7.7 L 8.5 2.3";
                stroke: Token.azione-testo; stroke-width: Token.tratto * 0.75;
                fill: transparent;
            }
        }
        Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.testo; wrap: word-wrap; horizontal-stretch: 1; font-size: Token.corpo-stato * Aspetto.scala; color: Token.testo; }
    }
    chiave := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.dato = !root.dato; return accept; }
            return reject;
        }
        changed has-focus => { if (self.has-focus) { root.ensure-visible(ScrollBehavior.instant); } }
    }
    TouchArea { clicked => { root.dato = !root.dato; } }
}

// One microphone to record from, when the computer has more than one: a row to choose, with the focus ring of the voice.
export component RigaMicrofono inherits Rectangle {
    in property <string> nome;
    in property <bool> scelto;
    // the arrows move the choice along the list, like in the voice menu: -1 up, 1 down (the list moves the focus)
    in property <int> indice;
    in property <int> bersaglio: -1;
    in property <int> richiesta: 0;
    callback scelta();
    callback sposta(int);
    changed richiesta => { if (self.bersaglio == self.indice) { chiave.focus(); } }
    property <bool> sopra: tocco.has-hover || chiave.has-focus;
    accessible-role: radio-button;
    accessible-label: root.nome;
    accessible-checked: root.scelto;
    accessible-action-default => { root.scelta(); }
    forward-focus: chiave;
    height: Token.altezza-comando-piccolo * Aspetto.scala;
    border-radius: self.height / 2;
    background: root.sopra ? Token.velo-sopra : transparent;
    border-width: chiave.has-focus ? Token.tratto : 0;
    border-color: Token.voce;
    HorizontalLayout {
        padding-left: Token.spazio-controlli * Aspetto.scala;
        padding-right: Token.spazio-medio * Aspetto.scala;
        spacing: Token.spazio-controlli * Aspetto.scala;
        Rectangle {
            width: Token.punto * 1.6 * Aspetto.scala; height: self.width;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: root.scelto ? Token.azione : transparent;
            border-width: Token.filo * 2;
            border-color: root.scelto ? Token.azione : Token.bordo-comando;
        }
        Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.nome; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Token.testo; font-size: Token.corpo-stato * Aspetto.scala; font-weight: root.scelto ? Token.peso-forte : Token.peso-testo; }
    }
    chiave := FocusScope {
        key-pressed(e) => {
            if (e.text == " " || e.text == Key.Return) { root.scelta(); return accept; }
            if (e.text == Key.UpArrow) { root.sposta(-1); return accept; }
            if (e.text == Key.DownArrow) { root.sposta(1); return accept; }
            return reject;
        }
        changed has-focus => { if (self.has-focus) { root.ensure-visible(ScrollBehavior.instant); } }
    }
    tocco := TouchArea { mouse-cursor: pointer; clicked => { root.scelta(); } }
}

// A stretch the voice can be made from: choose it, and listen to it before choosing.
export component RigaTratto inherits Rectangle {
    in property <Tratto> tratto;
    in property <bool> scelto;
    in property <bool> ascolta;
    // the arrows move along the list (the focus, and the choice where a voice can be made): -1 up, 1 down
    in property <int> indice;
    in property <int> bersaglio: -1;
    in property <int> richiesta: 0;
    callback scelta();
    callback ascolto();
    callback sposta(int);
    changed richiesta => { if (self.bersaglio == self.indice) { chiave.focus(); } }
    property <bool> sopra: tocco.has-hover || chiave.has-focus;
    accessible-role: radio-button;
    accessible-label: root.tratto.titolo + ". " + root.tratto.dettaglio;
    accessible-checked: root.scelto;
    accessible-enabled: root.tratto.utilizzabile;
    accessible-action-default => { if (root.tratto.utilizzabile) { root.scelta(); } }
    forward-focus: chiave;
    min-height: colonna.preferred-height;
    border-radius: Token.raggio-pannello * Aspetto.scala;
    background: root.scelto ? Token.velo-scelto : root.sopra ? Token.velo-sopra : transparent;
    border-width: chiave.has-focus ? Token.tratto : Token.filo;
    border-color: chiave.has-focus ? Token.voce : Token.bordo;
    animate background { duration: Token.durata-scurisce; easing: Token.curva-dolce; }
    tocco := TouchArea { mouse-cursor: root.tratto.utilizzabile ? pointer : default; clicked => { if (root.tratto.utilizzabile) { root.scelta(); } } }
    // the focus and the keys sit under the controls of the row
    chiave := FocusScope {
        key-pressed(e) => {
            if ((e.text == " " || e.text == Key.Return) && root.tratto.utilizzabile) { root.scelta(); return accept; }
            if (e.text == Key.UpArrow) { root.sposta(-1); return accept; }
            if (e.text == Key.DownArrow) { root.sposta(1); return accept; }
            return reject;
        }
        changed has-focus => { if (self.has-focus) { root.ensure-visible(ScrollBehavior.instant); } }
    }
    colonna := VerticalLayout {
        padding: Token.spazio-controlli * Aspetto.scala;
        padding-left: Token.spazio-medio * Aspetto.scala;
        spacing: Token.spazio-stretto * Aspetto.scala;
        HorizontalLayout {
            spacing: Token.spazio-controlli * Aspetto.scala;
            Rectangle {
                width: Token.punto * 1.6 * Aspetto.scala; height: self.width;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: root.scelto ? Token.azione : transparent;
                border-width: Token.filo * 2;
                border-color: root.scelto ? Token.azione : Token.bordo-comando;
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.tratto.titolo; wrap: word-wrap; font-size: Token.corpo-comando * Aspetto.scala; font-weight: Token.peso-forte; color: root.tratto.utilizzabile ? Token.testo : Token.testo-spento; }
                Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.tratto.dettaglio; wrap: word-wrap; font-size: Token.corpo-nota * Aspetto.scala; color: Token.testo-tenue; }
            }
            Pulsante {
                y: (parent.height - self.height) / 2;
                testo: root.ascolta ? @tr("programma.comune.ferma" => "Ferma") : @tr("programma.crea.ascolta" => "Ascolta");
                // TRANSLATORS: Read aloud by a screen reader: {} is the name of the stretch
                accessible-label: root.ascolta ? @tr("programma.crea.ferma-ascolto-tratto" => "Ferma l'ascolto di {}", root.tratto.titolo) : @tr("programma.crea.ascolta-tratto" => "Ascolta {}", root.tratto.titolo);
                piccolo: true;
                tipo: Tipo.quieto;
                premuto => { root.ascolto(); }
            }
        }
        if root.tratto.messaggi != "": Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
            text: root.tratto.messaggi;
            wrap: word-wrap;
            font-size: Token.corpo-nota * Aspetto.scala;
            color: root.tratto.utilizzabile ? Token.testo-tenue : Token.attenzione;
        }
    }
}

// Step 0: how to make the voice.
component PassoScelta inherits VerticalLayout {
    spacing: Token.spazio-medio * Aspetto.scala;
    if Creazione.errore != "": Avviso {
        testo: Creazione.errore;
        con-guida: Creazione.errore-aiuto;
        guida => { Creazione.apri-guida(); }
    }
    if Creazione.importa-in-corso: Attesa {
        // TRANSLATORS: While a file is read: {} is the name of the file
        testo: @tr("programma.crea.leggo" => "Leggo «{}»…", Creazione.importa-file);
        dettaglio: @tr("programma.crea.cerco-parte-cui-si" => "Cerco la parte in cui si sente meglio la voce.");
        valore: Creazione.importa-avanzamento;
        annulla => { Creazione.importa-annulla(); }
    }
    if !Creazione.importa-in-corso: principale := Strada {
        // the focus enters the step on its main way, so the keyboard needs no search
        init => { self.focus(); }
        principale: true;
        per-chi: @tr("programma.crea.se-hai-ancora-voce" => "Se hai ancora la voce");
        titolo: @tr("programma.crea.registrala-adesso" => "Registrala adesso");
        testo: @tr("programma.crea.istruzioni-registra" => "Leggi ad alta voce un breve testo. Bastano dodici secondi di voce chiara, meglio finché la voce è forte.");
        scelta => { Creazione.registra-scelta(); }
    }
    if !Creazione.importa-in-corso: Strada {
        principale: false;
        per-chi: @tr("programma.crea.se-voce-non-c" => "Se la voce non c'è più");
        titolo: @tr("programma.crea.usa-vecchie-registrazioni" => "Usa vecchie registrazioni");
        testo: @tr("programma.crea.messaggio-vocale-video-registrazione" => "Un messaggio vocale, un video, una registrazione di prima: WAV, FLAC, MP3, OGG, OPUS, M4A, MP4 o WEBM.");
        scelta => { Creazione.importa(); }
    }
    if !Creazione.importa-in-corso: Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
        text: @tr("programma.crea.stanza-tranquilla-se-c" => "Una stanza tranquilla e, se c'è, un microfono a cuffia. Puoi crearla anche per un'altra persona, con il suo permesso.");
        wrap: word-wrap;
        font-size: Token.corpo-stato * Aspetto.scala;
        color: Token.testo-tenue;
    }
    Rectangle { vertical-stretch: 1; }
}

// Step 1: read the text aloud while the level and the twelve seconds show.
component PassoRegistra inherits VerticalLayout {
    in property <string> da-leggere;
    init => { registra-tondo.focus(); }
    // the row the arrows move the focus to
    property <int> bersaglio: 0;
    property <int> richiesta: 0;
    property <duration> utile: Token.registrazione-utile;
    property <int> decimi: Creazione.registrato / Token.intervallo-registrazione;
    property <string> numero-tempo: floor(self.decimi / 10) + Platform.decimal-separator + mod(self.decimi, 10);
    // TRANSLATORS: {0} is the time recorded so far, a number with one decimal («3,2»): the unit is seconds
    property <string> tempo: @tr("programma.crea.secondi" => "{} s", self.numero-tempo);
    property <bool> basta: Creazione.parlato >= Token.registrazione-utile;
    spacing: Token.spazio-largo * Aspetto.scala;
    Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
        text: root.da-leggere;
        wrap: word-wrap;
        font-size: Token.corpo-lettura * Aspetto.scala;
        font-weight: Token.peso-medio;
        color: Creazione.registra ? Token.testo : Token.testo-tenue;
        animate color { duration: Token.durata-scurisce; easing: Token.curva-dolce; }
        vertical-stretch: 1;
    }
    // more than one microphone: the person chooses which hears the voice (never Kalliope's own)
    if Creazione.microfoni.length > 1 && !Creazione.registra && !Creazione.apro && !Creazione.controllo: VerticalLayout {
        spacing: Token.spazio-minimo * Aspetto.scala;
        Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: @tr("programma.crea.microfono" => "Microfono"); font-size: Token.corpo-nota * Aspetto.scala; color: Token.testo-tenue; }
        for m[i] in Creazione.microfoni: RigaMicrofono {
            nome: m;
            indice: i;
            bersaglio: root.bersaglio;
            richiesta: root.richiesta;
            scelto: i == Creazione.microfono;
            scelta => { Creazione.scegli-microfono(i); }
            sposta(d) => {
                root.bersaglio = clamp(i + d, 0, Creazione.microfoni.length - 1);
                Creazione.scegli-microfono(root.bersaglio);
                root.richiesta += 1;
            }
        }
    }
    Livello { attivo: Creazione.registra; forza: clamp(Creazione.livello, 0.12, 1); }
    if Creazione.errore != "": Avviso {
        testo: Creazione.errore;
        con-guida: Creazione.errore-aiuto;
        guida => { Creazione.apri-guida(); }
    }
    HorizontalLayout {
        spacing: Token.spazio-largo * Aspetto.scala;
        alignment: start;
        registra-tondo := Registra {
            registra: Creazione.registra;
            occupato: Creazione.apro || Creazione.controllo;
            avanzamento: Creazione.parlato / Token.registrazione-utile;
            premuto => { Creazione.registra-premuto(); }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            spacing: Token.spazio-minimo * Aspetto.scala;
            Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                text: Creazione.apro ? @tr("programma.crea.apro-microfono" => "Apro il microfono…")
                    : Creazione.controllo ? @tr("programma.crea.controllo-registrazione" => "Controllo la registrazione…")
                    : !Creazione.registra ? @tr("programma.crea.premi-tondo-leggi" => "Premi il tondo e leggi")
                    : root.basta ? root.tempo
                    // TRANSLATORS: While the voice is recorded: {0} is the time recorded so far («3,2 s»); {n} is how many whole seconds of clear voice are still needed
                    : @tr("programma.crea.mancano" => "{0} · ne manca {n}" | "{0} · ne mancano {n}" % ceil((Token.registrazione-utile - Creazione.parlato) / 1s), root.tempo); // fisso: un secondo, l'unità del conto alla rovescia
                wrap: word-wrap;
                font-size: Token.corpo-bolla * Aspetto.scala;
                font-weight: Token.peso-forte;
                color: Token.testo;
            }
            Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                text: Creazione.suggerimento != "" ? Creazione.suggerimento
                    : root.basta ? @tr("programma.crea.basta-cosi-premi-nuovo" => "Basta così: premi di nuovo per fermare.")
                    : @tr("programma.crea.ne-bastano-dodici-secondi" => "Ne bastano dodici secondi di voce: il cerchio si riempie. Il livello si muove con la tua voce.");
                wrap: word-wrap;
                font-size: Token.corpo-stato * Aspetto.scala;
                color: Creazione.suggerimento != "" ? Token.attenzione : root.basta ? Token.azione : Token.testo-tenue;
            }
        }
        if Creazione.registra: Pulsante {
            y: (parent.height - self.height) / 2;
            testo: @tr("programma.comune.annulla" => "Annulla");
            tipo: Tipo.nudo;
            premuto => { Creazione.registra-annulla(); }
        }
    }
}

// Step 2: listen, choose the stretch, name the voice, say whose it is.
component PassoAscolta inherits VerticalLayout {
    property <int> bersaglio: 0;
    property <int> richiesta: 0;
    spacing: Token.spazio-medio * Aspetto.scala;
    // the parts keep together under the title, as in the approved render; the room that is left stays empty below
    alignment: start;
    property <bool> unico: Creazione.tratti.length <= 1;
    if Creazione.nota != "": Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: Creazione.nota; wrap: word-wrap; font-size: Token.corpo-stato * Aspetto.scala; color: Token.testo-tenue; }
    if root.unico: HorizontalLayout {
        spacing: Token.spazio-largo * Aspetto.scala;
        ascolta-comando := Pulsante {
            init => { self.focus(); }
            testo: Creazione.ascolto >= 0 ? @tr("programma.crea.ferma-ascolto" => "Ferma l'ascolto") : @tr("programma.crea.ascolta-registrazione" => "Ascolta la registrazione");
            tipo: Tipo.quieto;
            // listening stays possible when no voice can be made: to hear why is the way to know what to record again
            abilitato: Creazione.tratti.length > 0;
            premuto => { if (Creazione.ascolto >= 0) { Creazione.ferma-ascolto(); } else { Creazione.ascolta(0); } }
        }
        Livello { attivo: Creazione.ascolto >= 0; forma: true; forza: 0.6; horizontal-stretch: 1; height: Token.altezza-comando * Aspetto.scala; }
        Pulsante {
            testo: @tr("programma.crea.rifai" => "Rifai");
            tipo: Tipo.nudo;
            premuto => { Creazione.rifai(); }
        }
    }
    // a stretch that cannot make a voice is a problem; one that can, with a flaw, is a word of advice
    if root.unico && Creazione.tratti.length == 1 && Creazione.tratti[0].messaggi != "" && !Creazione.tratti[0].utilizzabile: Avviso {
        testo: Creazione.tratti[0].messaggi;
    }
    if root.unico && Creazione.tratti.length == 1 && Creazione.tratti[0].messaggi != "" && Creazione.tratti[0].utilizzabile: Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
        text: Creazione.tratti[0].messaggi;
        wrap: word-wrap;
        font-size: Token.corpo-stato * Aspetto.scala;
        color: Token.testo-tenue;
    }
    if !root.unico: VerticalLayout {
        spacing: Token.spazio-controlli * Aspetto.scala;
        HorizontalLayout {
            alignment: start;
            spacing: Token.spazio-medio * Aspetto.scala;
            Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                // TRANSLATORS: After a recording is read: {n} is how many stretches with a voice were found
                text: @tr("programma.crea.trovati-tratti" => "Ho trovato {n} tratto in cui si sente la voce. Ascolta e scegli." | "Ho trovato {n} tratti in cui si sente la voce. Ascolta e scegli." % Creazione.tratti.length);
                wrap: word-wrap;
                vertical-alignment: center;
                font-size: Token.corpo-stato * Aspetto.scala;
                color: Token.testo-tenue;
            }
            Pulsante { testo: @tr("programma.crea.rifai" => "Rifai"); tipo: Tipo.nudo; premuto => { Creazione.rifai(); } }
        }
        for t[i] in Creazione.tratti: RigaTratto {
            init => { if (i == 0) { self.focus(); } }
            indice: i;
            bersaglio: root.bersaglio;
            richiesta: root.richiesta;
            sposta(d) => {
                root.bersaglio = clamp(i + d, 0, Creazione.tratti.length - 1);
                if (Creazione.tratti[root.bersaglio].utilizzabile) { Creazione.tratto-scelto = root.bersaglio; }
                root.richiesta += 1;
            }
            tratto: t;
            scelto: i == Creazione.tratto-scelto;
            ascolta: i == Creazione.ascolto;
            scelta => { Creazione.tratto-scelto = i; }
            ascolto => { if (i == Creazione.ascolto) { Creazione.ferma-ascolto(); } else { Creazione.ascolta(i); } }
        }
    }
    if Creazione.crea-in-corso: Attesa {
        // TRANSLATORS: While a voice is made: {} is the name the person gave it
        testo: @tr("programma.crea.creo-voce" => "Creo la voce «{}»…", Creazione.nome);
        dettaglio: @tr("programma.crea.ci-vuole-poco-quando" => "Ci vuole poco. Quando è pronta la scegli da sola.");
        valore: Creazione.crea-avanzamento;
        annulla => { Creazione.crea-annulla(); }
    }
    if !Creazione.crea-in-corso: VerticalLayout {
        spacing: Token.spazio-medio * Aspetto.scala;
        alignment: start;
        Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
            text: @tr("programma.crea.come-si-chiama-questa" => "Come si chiama questa voce?");
            font-size: Token.corpo-comando * Aspetto.scala;
            font-weight: Token.peso-forte;
            color: Token.testo;
        }
        Rectangle {
            height: Token.altezza-comando * 1.3 * Aspetto.scala;
            border-radius: Token.raggio-pannello * Aspetto.scala;
            background: Token.campo;
            Tratteggio { width: 100%; height: 100%; raggio: Token.raggio-pannello * Aspetto.scala; colore: Creazione.nome-messaggio != "" ? Token.attenzione : nome-campo.has-focus ? Token.tratteggio-fuoco : Token.tratteggio; }
            nome-campo := TextInput { transform-scale-x: Token.verso;
                x: Token.spazio-medio * Aspetto.scala;
                width: parent.width - 2 * self.x;
                vertical-alignment: center;
                horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                text <=> Creazione.nome;
                font-size: Token.corpo-bolla * Aspetto.scala;
                color: Token.testo;
                accessible-label: @tr("programma.crea.nome-voce" => "Nome della voce");
                edited => { Creazione.nome-modificato(); }
                accepted => { consenso-voce.focus(); }
                changed has-focus => { if (self.has-focus) { self.ensure-visible(ScrollBehavior.instant); } }
            }
            if Creazione.nome == "": Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                x: Token.spazio-medio * Aspetto.scala;
                // TRANSLATORS: An example of a name in the empty field: a name of a person, not a sentence
                text: @tr("programma.crea.segnaposto-nome-voce" => "Per esempio: la voce di Anna");
                font-size: Token.corpo-bolla * Aspetto.scala;
                color: Token.segnaposto;
            }
        }
        if Creazione.nome-messaggio != "": Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
            text: Creazione.nome-messaggio;
            wrap: word-wrap;
            font-size: Token.corpo-stato * Aspetto.scala;
            color: Token.attenzione;
        }
        consenso-voce := Consenso {
            dato <=> Creazione.consenso;
            testo: @tr("programma.crea.mia-voce-oppure-persona" => "È la mia voce, oppure la persona che parla mi ha dato il permesso di usarla.");
        }
        if Creazione.permesso-messaggio != "": Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
            text: Creazione.permesso-messaggio;
            wrap: word-wrap;
            font-size: Token.corpo-stato * Aspetto.scala;
            color: Token.attenzione;
        }
    }
    Rectangle { vertical-stretch: 1; }
}

export component CreaVoce inherits Rectangle {
    // the steps exist only while the screen is on: each takes the keyboard focus when it comes, so it never falls into the void
    in property <bool> attiva: true;
    in property <string> da-leggere: @tr("programma.crea.ciao-sono-io-questa" => "Ciao, sono io. Questa è la mia voce, per le riunioni e per le persone a cui voglio bene. La leggo con calma, come parlo ogni giorno.");
    // the three steps with their names need about 730 px at 100%: below that, only the step one is on, with «n di 3»
    property <bool> stretta: root.width < Token.soglia-minima * 1.3 * Aspetto.scala;
    background: Token.fondo;
    forward-focus: primo;

    // The last step ends with «Crea la voce», and it must be seen: under the parts when they fit, and pinned at the foot of the
    // window, over a hairline and a soft edge, when they do not (three stretches at 920 × 640). The page scrolls under it, and the
    // edge says so (correction I-3). What the footer needs is measured without it, so showing it cannot change its own cause.
    property <bool> in-fondo: root.attiva && Creazione.passo == 2 && !Creazione.crea-in-corso;
    property <length> alto-piede: piede.preferred-height + 2 * Token.spazio-medio * Aspetto.scala;
    property <bool> trabocca: root.in-fondo && passi.preferred-height + root.alto-piede - Token.spazio-largo * Aspetto.scala > root.height;

    // in a small window the creation scrolls, nothing is cut
    scorre := Flickable {
        x: 0; y: 0; width: root.width;
        height: root.height - (root.trabocca ? root.alto-piede : 0);
        content-width: self.width;
        content-height: max(self.height, passi.preferred-height);
    passi := VerticalLayout {
        width: scorre.width;
        height: scorre.content-height;
        padding: Token.spazio-largo * Aspetto.scala;
        padding-top: Token.spazio-medio * Aspetto.scala;
        spacing: Token.spazio-largo * Aspetto.scala;
        HorizontalLayout {
            spacing: Token.spazio-largo * Aspetto.scala;
            primo := Pulsante { testo: root.stretta ? "" : @tr("programma.crea.torna-a-scrivere" => "Torna a scrivere"); indietro: true; accessible-label: @tr("programma.crea.torna-a-scrivere" => "Torna a scrivere"); tipo: Tipo.nudo; piccolo: true; premuto => { Creazione.esci(); } }
            Rectangle { horizontal-stretch: 1; }
            Passi { passo: Creazione.passo; compatti: root.stretta; }
        }
        Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
            text: Creazione.passo == 0 ? @tr("programma.crea.titolo-scegli" => "Come vuoi creare la tua voce?")
                : Creazione.passo == 1 ? @tr("programma.crea.titolo-leggi" => "Leggi ad alta voce, con calma")
                : @tr("programma.crea.titolo-nome" => "Ascoltala e dalle un nome");
            font-size: Token.corpo-titolo * Aspetto.scala;
            font-weight: Token.peso-titolo;
            color: Token.testo;
            wrap: word-wrap;
        }
        if root.attiva && Creazione.passo == 0: PassoScelta { }
        if root.attiva && Creazione.passo == 1: PassoRegistra { da-leggere: root.da-leggere; }
        if root.attiva && Creazione.passo == 2: PassoAscolta { }
    }
    }

    // the soft edge that says the page goes on under the footer
    if root.trabocca: Rectangle {
        x: 0; width: root.width;
        y: root.height - root.alto-piede - Token.spazio-largo * Aspetto.scala;
        height: Token.spazio-largo * Aspetto.scala;
        background: @linear-gradient(180deg, Token.fondo.transparentize(100%) 0%, Token.fondo 100%);
    }
    // the footer: the problem of the last gesture, why the button waits, and the button
    piede-fondo := Rectangle {
        visible: root.in-fondo;
        x: 0; width: root.width;
        y: root.trabocca ? root.height - root.alto-piede : passi.preferred-height - Token.spazio-largo * Aspetto.scala - Token.spazio-medio * Aspetto.scala;
        height: root.alto-piede;
        background: root.trabocca ? Token.fondo : transparent;
        if root.trabocca: Rectangle { y: 0; height: Token.filo; background: Token.bordo; }
        piede := VerticalLayout {
            x: Token.spazio-largo * Aspetto.scala; y: Token.spazio-medio * Aspetto.scala;
            width: root.width - 2 * Token.spazio-largo * Aspetto.scala;
            spacing: Token.spazio-controlli * Aspetto.scala;
            if Creazione.errore != "": Avviso {
                testo: Creazione.errore;
                con-guida: Creazione.errore-aiuto;
                guida => { Creazione.apri-guida(); }
            }
            HorizontalLayout {
                alignment: end;
                spacing: Token.spazio-largo * Aspetto.scala;
                Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                    // why the button waits: never a silent grey
                    text: !Creazione.utilizzabile ? @tr("programma.crea.questa-registrazione-non-si" => "Da questa registrazione non si può creare la voce: rifai.")
                        : !Creazione.nome-valido(Creazione.nome) ? @tr("programma.crea.manca-nome" => "Manca il nome.")
                        : !Creazione.consenso ? @tr("programma.crea.manca-permesso-spunta-casella" => "Manca il permesso: spunta la casella.")
                        : "";
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                    font-size: Token.corpo-nota * Aspetto.scala;
                    color: Token.testo-tenue;
                }
                Pulsante {
                    testo: Creazione.nome-conferma != "" ? Creazione.nome-conferma : @tr("programma.crea.crea-voce" => "Crea la voce");
                    tipo: Tipo.pieno;
                    abilitato: Creazione.utilizzabile && Creazione.nome-valido(Creazione.nome) && Creazione.consenso;
                    premuto => { Creazione.crea(); }
                }
            }
        }
    }
}
