// SPDX-License-Identifier: LicenseRef-SANSEVIERIA-1.1
// The window of Kalliope, direction «La frase che si accende»: you write in the dashed bubble of what is not yet said,
// Enter sends it up into the bubble where the voice says it, word after word, and it stays there, said, to repeat.
// Proportions (correction B1): the writing takes two parts of the room that is left, the phrases already said one part and
// scroll; the phrase being said stays whole between them. Below a height, or in the meeting mode, the window gathers:
// no history, the phrase being said on one line, the state in a word.
import { Token } from "token.slint";
import { Aspetto, Situazione } from "aspetto.slint";
import { Pulsante, Tipo, Punto, Freccia, Interruttore, Tratteggio } from "forme.slint";
import { RigaStato } from "stato.slint";
import { BollaVoce, FraseDetta } from "bolla.slint";
import { Scrittura } from "scrittura.slint";
import { CreaVoce } from "voce-propria.slint";
import { Menu } from "menu.slint";
import { Informazioni, Conferma } from "modali.slint";
import { Creazione } from "creazione.slint";

export enum Schermata { scrivi, crea-voce }

export component Finestra inherits Rectangle {
    in property <Situazione> situazione: Situazione.preparazione;
    in property <string> spiegazione;
    in property <bool> pronta: false;
    in property <bool> parla: false;
    in property <[string]> history;
    // the number of words of the last phrase (history[0]), and its beginning up to a number of words
    in property <int> parole;
    pure callback prefisso(string, int) -> string;
    pure callback da-destra(string) -> bool;
    in property <[string]> voices: ["Giulia", "Marco"];
    in-out property <int> voice-index: 0;
    in-out property <bool> monitor: true;
    in property <string> version;
    in-out property <string> draft;
    in-out property <bool> compatta: false;
    in-out property <Schermata> schermata: Schermata.scrivi;
    // the hint for keeping the window above the meeting: shown once, and only where the system does not let a program do it
    in-out property <bool> suggerimento-sopra: true;
    in property <bool> senza-primo-piano: false;
    // a short piece of news (a voice was made), which goes by itself
    in property <string> notizia;
    callback speak(string) -> bool;
    callback stop();
    callback voice-changed(int);
    callback monitor-changed(bool);
    callback compatta-cambiata(bool);
    callback scala-cambiata(float);
    callback suggerimento-letto();
    callback notizia-chiusa();
    callback apri-crea-voce();
    callback svuota-cronologia();
    callback apri-sito();
    // the page of the guide that answers the state the status line names (Rust builds the address, guida.rs)
    callback apri-guida(Situazione);

    // Which words are said comes from the engine's real pieces (avanzamento.rs): the words said so far (-1: all of them) and
    // how far the next word has darkened. After Stop the words not said stay faint, because they were not said.
    in property <int> dette-vere: -1;
    in property <float> sfumatura-vera: 0;
    property <int> dette: root.dette-vere >= 0 ? min(root.dette-vere, root.parole) : root.parole;
    property <float> sfumatura: root.parla ? root.sfumatura-vera : 0;
    // false for the first moments: the layout that exists at start is not animated
    property <bool> avviata: false;
    avvio := Timer { interval: Token.durata-bolla; running: true; triggered => { root.avviata = true; self.running = false; } }
    // a new phrase: false for one frame, then the bubble grows and the history slides up (correction I4)
    property <bool> nata: true;
    // the phrase that was in the bubble when Enter was pressed, kept for its leaving
    property <string> vecchia;
    property <length> storia-prima;
    property <length> salto: max(0px, frasi.preferred-height - root.storia-prima);
    property <float> fase-storia: root.nata ? 0 : 1;
    // the history slides evenly, so the passage is seen (the site's bubble passage: 2232 ms, mostly moving)
    animate fase-storia { duration: root.nata && !Aspetto.movimento-ridotto ? Token.durata-bolla : 0ms; easing: Token.curva-dolce; }
    property <float> nascita: root.nata || Aspetto.movimento-ridotto ? 1 : 0;
    // the new bubble is born when the old one has half gone (it fades in place, see «vecchia»), so the two texts never overlap
    animate nascita { delay: root.nata && !Aspetto.movimento-ridotto ? Token.ritardo-bolla : 0ms; duration: root.nata && !Aspetto.movimento-ridotto ? Token.durata-bolla : 0ms; easing: Token.curva-entrata; }
    // the arrangement: wide (wordmark), narrow (no wordmark, «Riunione» goes into «Altro»), low (gathered)
    property <bool> stretta: root.width < Token.soglia-stretta * Aspetto.scala;
    property <bool> minima: root.width < Token.soglia-minima * Aspetto.scala;
    property <bool> bassa: root.height < Token.soglia-bassa * Aspetto.scala;
    property <bool> raccolta: root.compatta || root.bassa;
    // the phrase being said on one line: in the meeting mode and in a window lower than the threshold at 100%;
    // otherwise it wraps and stays whole (correction I1)
    // At the largest text size the phrase says itself on one line unless the window is tall: three lines of it, the state and
    // the writing do not fit a low window, and the writing must keep its margin at the foot (correction M-2).
    // In a narrow window the state needs more lines, so the one-line phrase comes a fifth sooner (a 640 × 500 window with the
    // longest state lost the foot of the writing, found by sweeping the heights between 420 and 580).
    property <length> soglia-riga: Token.soglia-bassa * (root.width < Token.soglia-minima * 1.5 * Aspetto.scala ? 1.2 : 1);
    property <bool> una-riga: root.compatta || root.height < root.soglia-riga
        || (Aspetto.scala >= Token.scala-massima && root.height < Token.soglia-bassa * Token.scala-massima * 1.6);
    property <bool> male: root.situazione == Situazione.nessuno-ascolta || root.situazione == Situazione.senza-microfono
        || root.situazione == Situazione.problema-voce;
    // Giulia, Marco, then each voice made from a recording: the first of them has the tint of «Tu», the others the grey green of
    // the bars at rest
    property <[color]> tinte: [Token.tinta-voce-1, Token.tinta-voce-2, Token.tinta-propria, Token.tinta-voce-3, Token.tinta-voce-3, Token.tinta-voce-3];
    property <bool> menu-voce-aperto: false;
    property <bool> menu-altro-aperto: false;
    property <bool> info-aperta: false;
    property <bool> conferma-aperta: false;

    function ferma() {
        root.stop();
    }
    function di(testo: string) -> bool {
        root.storia-prima = frasi.preferred-height;
        // the bubble that is leaving stays a moment where it was and fades, while the new one grows and the old one joins the history
        root.vecchia = root.history.length > 0 ? root.history[0] : "";
        if (root.speak(testo)) {
            root.nata = false;
            rinascita.running = true;
            return true;
        }
        return false;
    }
    function apri-voce() { root.menu-altro-aperto = false; root.menu-voce-aperto = true; menu-voce.entra(); }
    function chiudi-voce() { root.menu-voce-aperto = false; voce-chiave.focus(); }
    function apri-altro() { root.menu-voce-aperto = false; root.menu-altro-aperto = true; menu-altro.entra(); }
    function chiudi-altro() { root.menu-altro-aperto = false; altro.focus(); }
    function piu-grande() { Aspetto.scala = min(Token.scala-massima, Aspetto.scala + Token.scala-passo); root.scala-cambiata(Aspetto.scala); }
    function piu-piccolo() { Aspetto.scala = max(1, Aspetto.scala - Token.scala-passo); root.scala-cambiata(Aspetto.scala); }
    function testo-normale() { Aspetto.scala = 1; root.scala-cambiata(Aspetto.scala); }
    public function apri-informazioni() { root.info-aperta = true; informazioni.apri(); }
    function chiudi-informazioni() { root.info-aperta = false; altro.focus(); }
    public function apri-conferma() { root.conferma-aperta = true; conferma-svuota.apri(); }
    function chiudi-conferma() { root.conferma-aperta = false; altro.focus(); }
    function in-fondo() { storia.content-y = min(0px, storia.height - storia.content-height); }
    public function metti-a-fuoco() { scrittura.focus(); }

    background: Token.fondo;
    forward-focus: scrittura;

    rinascita := Timer {
        interval: Token.intervallo-fotogramma;
        running: false;
        triggered => { root.nata = true; self.running = false; }
    }

    // Keys that work wherever the focus is: the text size (Ctrl and plus, minus, zero), and Esc, which stops the voice, or
    // leaves «Crea la tua voce». A menu or a dialog that is open keeps its own Esc.
    // The height of the newest phrase in the history, measured on a copy that is never seen (it sits outside every layout): the
    // list keeps the room for that phrase whole, or is not shown (correction I-1: half a bubble is worse than none).
    property <length> alto-ultima: 0px;
    if root.history.length > 1: FraseDetta {
        x: 0; y: 0;
        visible: false;
        testo: root.history[1];
        da-destra: root.da-destra(root.history[1]);
        larghezza-massima: min(root.width - 2 * Token.spazio-largo * Aspetto.scala, Token.bolla-larghezza * Aspetto.scala);
        init => { root.alto-ultima = self.height; }
        changed height => { root.alto-ultima = self.height; }
    }

    globali := FocusScope {
        x: 0; y: 0; width: root.width; height: root.height;
        focus-on-tab-navigation: false;
        capture-key-pressed(e) => {
            if (e.modifiers.control && (e.text == "+" || e.text == "=")) { root.piu-grande(); return accept; }
            if (e.modifiers.control && (e.text == "-" || e.text == "_")) { root.piu-piccolo(); return accept; }
            if (e.modifiers.control && e.text == "0") { root.testo-normale(); return accept; }
            if (e.text == Key.Escape && !root.menu-voce-aperto && !root.menu-altro-aperto && !root.info-aperta && !root.conferma-aperta) {
                if (root.schermata == Schermata.crea-voce) { Creazione.esci(); return accept; }
                if (root.parla) { root.ferma(); return accept; }
            }
            return reject;
        }

    VerticalLayout {
        x: 0; y: 0; width: root.width; height: root.height;
        visible: root.schermata == Schermata.scrivi || crea.aperta < 1;
        // the two screens never show their words together: going to «Crea la tua voce» the writing fades in the first half
        // and the creation comes in the second; coming back it is the other way round (correction: the texts overlapped for 100 ms)
        opacity: clamp(1 - 2 * crea.aperta, 0, 1);

        // The bar: the same commands at every text size. A− and A+ sit at the right edge, so a second press finds them
        // under the pointer; what does not fit goes into «Altro», which keeps its place (correction I2).
        barra := Rectangle {
            visible: !root.compatta;
            height: root.compatta ? 0 : Token.altezza-barra * Aspetto.scala;
            background: Token.barra;
            Rectangle { y: parent.height - self.height; height: Token.filo; background: Token.bordo; }
            HorizontalLayout {
                padding-left: Token.spazio-largo * Aspetto.scala * 0.75;
                padding-right: Token.spazio-stretto * Aspetto.scala;
                spacing: (root.minima ? Token.spazio-stretto : Token.spazio-controlli) * Aspetto.scala;
                Image { transform-scale-x: Token.verso;
                    source: @image-url("../../../../design-system/marchio/libero.svg");
                    width: Token.marchio * Aspetto.scala; height: self.width;
                    y: (parent.height - self.height) / 2;
                    accessible-role: none;
                }
                if !root.stretta: Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                    text: "Kalliope";
                    vertical-alignment: center;
                    font-size: Token.corpo-marchio * Aspetto.scala;
                    font-weight: Token.peso-forte;
                    color: Token.testo;
                }
                Rectangle { horizontal-stretch: 1; }
                voce := Rectangle {
                    property <bool> sopra: voce-tocco.has-hover || voce-chiave.has-focus;
                    accessible-role: combobox;
                    // TRANSLATORS: Read aloud by a screen reader for the voice menu: {} is the name of the voice in use
                    accessible-label: @tr("programma.finestra.voce" => "Voce: {}", root.voices[root.voice-index]);
                    accessible-action-default => { root.apri-voce(); }
                    y: (parent.height - self.height) / 2;
                    height: Token.altezza-comando-piccolo * Aspetto.scala;
                    width: min(voce-riga.preferred-width, Token.bolla-larghezza * Aspetto.scala / 3) + 2 * Token.spazio-controlli * Aspetto.scala;
                    horizontal-stretch: 0;
                    border-radius: self.height / 2;
                    background: self.sopra ? Token.velo-sopra : transparent;
                    border-width: voce-chiave.has-focus ? Token.tratto : Token.filo;
                    border-color: voce-chiave.has-focus ? Token.voce : Token.bordo-comando;
                    voce-riga := HorizontalLayout {
                        x: Token.spazio-controlli * Aspetto.scala;
                        width: parent.width - 2 * self.x;
                        spacing: Token.spazio-stretto * Aspetto.scala;
                        Punto { y: (parent.height - self.height) / 2; colore: root.tinte[root.voice-index]; lato: Token.punto * 1.4 * Aspetto.scala; }
                        Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea; text: root.voices[root.voice-index]; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; color: Token.testo; font-size: Token.corpo-stato * Aspetto.scala; font-weight: Token.peso-medio; }
                        Freccia { y: (parent.height - self.height) / 2; }
                    }
                    voce-chiave := FocusScope {
                        key-pressed(e) => {
                            if (e.text == " " || e.text == Key.Return || e.text == Key.DownArrow) { root.apri-voce(); return accept; }
                            return reject;
                        }
                    }
                    voce-tocco := TouchArea { mouse-cursor: pointer; clicked => { if (root.menu-voce-aperto) { root.chiudi-voce(); } else { root.apri-voce(); } } }
                }
                if !root.minima: Pulsante {
                    y: (parent.height - self.height) / 2;
                    testo: @tr("programma.finestra.riunione" => "Riunione"); piccolo: true; tipo: Tipo.quieto;
                    // TRANSLATORS: Read aloud by a screen reader for the «Riunione» button: the meeting mode shows the writing, the state and Stop
                    accessible-label: @tr("programma.finestra.modalita-riunione-solo-scrittura" => "Modalità riunione: solo scrittura, stato e Ferma");
                    premuto => { root.compatta = true; root.compatta-cambiata(true); scrittura.focus(); }
                }
                altro := Pulsante {
                    y: (parent.height - self.height) / 2;
                    testo: @tr("programma.finestra.altro" => "Altro"); piccolo: true; tipo: Tipo.quieto;
                    // TRANSLATORS: Read aloud by a screen reader for the «Altro» menu: say what it holds
                    accessible-label: @tr("programma.finestra.altro-crea-tua-voce" => "Altro: crea la tua voce, informazioni");
                    premuto => { if (root.menu-altro-aperto) { root.chiudi-altro(); } else { root.apri-altro(); } }
                }
                testo := HorizontalLayout {
                    spacing: 0;
                    Pulsante {
                        y: (parent.height - self.height) / 2;
                        // TRANSLATORS: The button that makes the text smaller: a capital A with a minus sign
                        testo: @tr("programma.finestra.a-meno" => "A−"); tipo: Tipo.nudo; piccolo: true;
                        abilitato: Aspetto.scala > 1;
                        accessible-label: @tr("programma.finestra.testo-piu-piccolo" => "Testo più piccolo");
                        premuto => { root.piu-piccolo(); }
                    }
                    Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                        text: round(Aspetto.scala * 100) + "%";
                        vertical-alignment: center;
                        color: Token.testo-tenue;
                        font-size: Token.corpo-nota * Aspetto.scala;
                    }
                    Pulsante {
                        y: (parent.height - self.height) / 2;
                        // TRANSLATORS: The button that makes the text larger: a capital A with a plus sign
                        testo: @tr("programma.finestra.a-piu" => "A+"); tipo: Tipo.nudo; piccolo: true;
                        abilitato: Aspetto.scala < Token.scala-massima;
                        accessible-label: @tr("programma.finestra.testo-piu-grande" => "Testo più grande");
                        premuto => { root.piu-grande(); }
                    }
                }
            }
        }

        corpo := VerticalLayout {
            padding: (root.raccolta ? Token.spazio-controlli : Token.spazio-largo) * Aspetto.scala;
            padding-top: Token.spazio-controlli * Aspetto.scala;
            spacing: (root.raccolta ? Token.spazio-stretto : Token.spazio-controlli) * Aspetto.scala;

            // The phrases already said: they yield the room and scroll. Bottom-anchored, they slide up when a phrase is added.
            storia := Flickable {
                // not a piece of a bubble: where there is no room for one whole phrase the list is not shown at all (correction I-1)
                // (the outline of the first bubble shows whole or not at all; a list shows at least one phrase of two lines)
                visible: !root.raccolta && self.height >= (root.history.length == 0 ? frasi.preferred-height : min(frasi.preferred-height, root.alto-ultima));
                vertical-stretch: root.raccolta ? 0 : Token.quota-storia;
                // where the window is tall enough and the newest phrase has two lines, its room is kept whole, taken from the writing's share
                // (a phrase of one line already fits the share the list has: the layout of the approved render is left as it is)
                min-height: root.history.length > 1 && !root.raccolta && root.height >= Token.soglia-bassa * 1.25 * Aspetto.scala
                    && root.alto-ultima > Token.altezza-comando * 1.2 * Aspetto.scala ? min(root.alto-ultima, root.height) : 0;
                preferred-height: 0;
                max-height: root.raccolta ? 0 : root.height;
                content-width: self.width;
                content-height: max(self.height, frasi.preferred-height);
                // The list stays at its end: a binding would be lost the first time the list is moved (the wheel, a Tab that
                // passes over a phrase), so the end is reached again by hand whenever the phrases or the room change, and when the
                // focus comes back to the writing.
                init => { root.in-fondo(); }
                changed content-height => { root.in-fondo(); }
                changed height => { root.in-fondo(); }
                frasi := VerticalLayout {
                    y: root.salto * root.fase-storia;
                    width: storia.width;
                    height: storia.content-height;
                    alignment: end;
                    spacing: Token.spazio-stretto * Aspetto.scala;
                    // Nothing said yet: an outline of the bubble that will come, dashed like the logo's «not yet said».
                    // (not when the voice cannot start: it would promise what cannot happen, correction I6)
                    if root.history.length == 0 && root.situazione != Situazione.problema-voce: HorizontalLayout {
                        alignment: start;
                        Rectangle {
                            width: min(root.width - 2 * Token.spazio-largo * Aspetto.scala, Token.bolla-larghezza * Aspetto.scala * 0.75);
                            height: vuota.preferred-height + 2 * Token.spazio-medio * Aspetto.scala;
                            Tratteggio {
                                width: 100%; height: 100%;
                                raggio: Token.raggio-bolla * Aspetto.scala;
                                tratto: Token.tratto * 0.67;
                                colore: Token.bordo-comando;
                            }
                            vuota := Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                                x: Token.spazio-largo * Aspetto.scala * 0.85;
                                width: parent.width - 2 * self.x;
                                text: @tr("programma.finestra.qui-voce-dira-tue" => "Qui la voce dirà le tue frasi, una parola dopo l'altra. Restano qui: un clic, o Tab e Invio, le dice di nuovo.");
                                wrap: word-wrap;
                                color: Token.testo-tenue;
                                font-size: Token.corpo-detta * Aspetto.scala;
                            }
                        }
                    }
                    for i in max(0, root.history.length - 1): HorizontalLayout {
                        alignment: start;
                        FraseDetta {
                            testo: root.history[root.history.length - 1 - i];
                            da-destra: root.da-destra(self.testo);
                            abilitata: root.pronta;
                            larghezza-massima: min(root.width - 2 * Token.spazio-largo * Aspetto.scala, Token.bolla-larghezza * Aspetto.scala);
                            ripeti => { root.di(self.testo); scrittura.focus(); }
                        }
                    }
                }
                // the oldest phrase fades under the bar instead of being cut
                Rectangle {
                    y: -storia.content-y;
                    height: Token.spazio-largo * Aspetto.scala;
                    background: @linear-gradient(180deg, Token.fondo 0%, Token.fondo.transparentize(100%) 100%);
                }
            }

            // The phrase being said: outside the scroll, always whole (correction I1). It rises from the writing as it grows.
            if root.history.length > 0: Rectangle {
                // The place of the phrase grows with the phrase, in the time of the passage, instead of opening in one frame: the
                // first phrase of all made the writing drop by the height of a bubble at once (62 px, correction M-1). Not at start,
                // when the place already holds the phrases kept from before.
                property <bool> pronto: !root.avviata;
                property <length> alto: self.pronto ? bolla.height : 0px;
                animate alto {
                    delay: Aspetto.movimento-ridotto ? 0ms : Token.ritardo-bolla;
                    duration: Aspetto.movimento-ridotto ? 0ms : Token.durata-bolla;
                    easing: Token.curva-dolce;
                }
                // one frame at nothing, so the growth is seen (a binding read for the first time at its end would not move)
                Timer { interval: Token.intervallo-fotogramma; running: true; triggered => { parent.pronto = true; self.running = false; } }
                height: self.alto;
                // the old bubble does not vanish in one frame: it fades in the time the new one grows (correction of the weak point left
                // in the direction, «a Invio c'è ancora un salto»)
                if root.vecchia != "": BollaVoce {
                    x: 0;
                    y: parent.height - self.height;
                    accessible-role: none;
                    testo: root.vecchia;
                    da-destra: root.da-destra(root.vecchia);
                    detto: root.vecchia;
                    dicendo: root.vecchia;
                    riga-sola: root.una-riga;
                    corpo: (root.raccolta && !root.una-riga ? Token.corpo-detta : Token.corpo-bolla) * Aspetto.scala;
                    larghezza-massima: root.una-riga ? root.width - 2 * Token.spazio-controlli * Aspetto.scala
                        : min(root.width - 3 * Token.spazio-largo * Aspetto.scala, Token.bolla-larghezza * Aspetto.scala);
                    // fase-storia starts at 1 when Enter is pressed and falls to 0 in the time of the passage: the old bubble is whole at
                    // first and gone before the history has arrived
                    opacity: clamp((root.fase-storia - 0.55) / 0.45, 0, 1);
                    visible: self.opacity > 0;
                }
                bolla := BollaVoce {
                    x: 0;
                    y: parent.height - self.height + (1 - root.nascita) * Token.spostamento-entrata * 2;
                    testo: root.history[0];
                    da-destra: root.da-destra(root.history[0]);
                    detto: root.prefisso(root.history[0], root.dette);
                    dicendo: root.prefisso(root.history[0], root.dette + 1);
                    sfumatura: root.sfumatura;
                    parla: root.parla;
                    non-sentita: root.situazione == Situazione.nessuno-ascolta;
                    riga-sola: root.una-riga;
                    corpo: (root.raccolta && !root.una-riga ? Token.corpo-detta : Token.corpo-bolla) * Aspetto.scala;
                    larghezza-massima: root.una-riga ? root.width - 2 * Token.spazio-controlli * Aspetto.scala
                        : min(root.width - 3 * Token.spazio-largo * Aspetto.scala, Token.bolla-larghezza * Aspetto.scala);
                    nascita: root.nascita;
                }
            }

            RigaStato {
                situazione: root.situazione;
                notizia: root.notizia;
                spiegazione: root.spiegazione;
                compatta: root.raccolta;
                // the state above, its words across the whole width below, wherever the words would need more than three lines beside
                // it (a 640 px window: five lines, and the writing below lost its foot, correction M-2)
                impilata: root.width < Token.soglia-minima * 1.5 * Aspetto.scala && !root.raccolta;
                // where a problem has a way out, it is offered next to it (correction I6)
                if root.male: Pulsante {
                    y: (parent.height - self.height) / 2;
                    // gathered, the word is short, so the row keeps «Intera» in view (a 400 px window)
                    testo: root.raccolta ? @tr("programma.finestra.aiuto" => "Aiuto") : @tr("programma.comune.come-si-risolve" => "Come si risolve"); piccolo: true; tipo: Tipo.quieto;
                    accessible-label: @tr("programma.comune.come-si-risolve" => "Come si risolve");
                    premuto => { root.apri-guida(root.situazione); }
                }
                if root.compatta: Pulsante {
                    y: (parent.height - self.height) / 2;
                    testo: root.minima ? @tr("programma.finestra.intera" => "Intera") : @tr("programma.finestra.finestra-intera" => "Finestra intera"); piccolo: true; tipo: Tipo.nudo; espandi: true;
                    accessible-label: @tr("programma.finestra.finestra-intera" => "Finestra intera");
                    premuto => { root.compatta = false; root.compatta-cambiata(false); scrittura.focus(); }
                }
            }
            // the hint shows only where the system does not let a program stay above the others (Wayland), once, and only
            // where it leaves room for the writing (correction I3)
            if root.compatta && root.suggerimento-sopra && root.senza-primo-piano && root.height >= Token.compatta-altezza * Aspetto.scala: HorizontalLayout {
                spacing: Token.spazio-stretto * Aspetto.scala;
                padding-left: Token.spazio-stretto * Aspetto.scala;
                Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                    // TRANSLATORS: A hint on Wayland: Alt+Space opens the window menu, where «Sempre in primo piano» («Always on top») is a command of the person's desktop: keep both as the desktop calls them
                    text: @tr("programma.finestra.tenerla-sopra-riunione-alt" => "Per tenerla sopra la riunione: Alt+Spazio, poi «Sempre in primo piano».");
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    font-size: Token.corpo-nota * Aspetto.scala;
                    color: Token.testo-tenue;
                }
                Pulsante { testo: @tr("programma.finestra.ho-capito" => "Ho capito"); piccolo: true; tipo: Tipo.nudo; premuto => { root.suggerimento-sopra = false; root.suggerimento-letto(); scrittura.focus(); } }
            }
            scrittura := Scrittura {
                changed ha-fuoco => { if (self.ha-fuoco) { root.in-fondo(); } }
                compatta: root.raccolta;
                vertical-stretch: Token.quota-scrittura;
                preferred-height: self.min-height;
                testo <=> root.draft;
                pronta: root.pronta;
                parla: root.parla;
                prepara: root.situazione == Situazione.preparazione;
                ultima: root.history.length > 0 ? root.history[0] : "";
                // the empty field follows the state: it never promises «Invio» when the voice cannot take the phrase
                segnaposto: root.situazione == Situazione.preparazione ? (root.raccolta ? @tr("programma.finestra.segnaposto-fra-poco" => "Fra poco.") : @tr("programma.finestra.segnaposto-puoi-gia-scrivere" => "Puoi già scrivere: la voce arriva fra poco."))
                    : root.situazione == Situazione.problema-voce ? (root.raccolta ? @tr("programma.finestra.segnaposto-voce-non-parte" => "La voce non parte.") : @tr("programma.finestra.segnaposto-voce-non-parte-guarda" => "La voce non parte: guarda qui sopra."))
                    // TRANSLATORS: In the empty writing field; Invio is the Enter key
                    : root.raccolta ? @tr("programma.comune.segnaposto-scrivi-qui" => "Scrivi qui.") : @tr("programma.comune.segnaposto-scrivi-invio" => "Scrivi qui. Invio la dice.");
                dici(t) => { return root.di(t); }
                ferma => { root.ferma(); }
            }
        }
    }

    // Creating a voice comes in from the side and goes back the same way.
    crea := CreaVoce {
        property <float> aperta: root.schermata == Schermata.crea-voce ? 1 : 0;
        animate aperta {
            duration: Aspetto.movimento-ridotto ? 0ms : (root.schermata == Schermata.crea-voce ? Token.durata-pannello : Token.durata-pannello-uscita);
            easing: root.schermata == Schermata.crea-voce ? Token.curva-entrata : Token.curva-dolce;
        }
        attiva: self.aperta > 0;
        visible: self.aperta > 0;
        opacity: clamp(2 * self.aperta - 1, 0, 1);
        x: Token.spostamento-entrata * 2 * (1 - self.aperta); y: 0; width: root.width; height: root.height;
    }

    // A click outside an open menu closes it.
    if root.menu-voce-aperto || root.menu-altro-aperto: TouchArea {
        x: 0; y: 0; width: root.width; height: root.height;
        clicked => {
            if (root.menu-voce-aperto) { root.chiudi-voce(); }
            if (root.menu-altro-aperto) { root.chiudi-altro(); }
        }
    }
    menu-voce := Menu {
        aperto: root.menu-voce-aperto;
        titolo: @tr("programma.finestra.con-quale-voce-parli" => "Con quale voce parli");
        voci: root.voices;
        tinte: root.tinte;
        in-uso: root.voice-index;
        x: root.width - self.width - Token.spazio-medio * Aspetto.scala;
        y: Token.altezza-barra * Aspetto.scala - Token.spostamento-entrata / 2 * (1 - self.fase);
        width: min(root.width - 2 * Token.spazio-medio * Aspetto.scala, Token.bolla-larghezza * Aspetto.scala / 2);
        scelta(i) => { root.voice-index = i; root.voice-changed(i); root.chiudi-voce(); }
        chiudi => { root.chiudi-voce(); }
        Rectangle { height: Token.filo; background: Token.bordo; }
        Interruttore {
            acceso <=> root.monitor;
            testo: @tr("programma.finestra.senti-anche-tu-voce" => "Senti anche tu la voce");
            cambiato(on) => { root.monitor-changed(on); }
        }
    }
    menu-altro := Menu {
        aperto: root.menu-altro-aperto;
        // «Riunione» joins when the bar has no room for it; «Svuota la cronologia» only when there is a history
        voci: root.minima
            ? (root.history.length > 0 ? [@tr("programma.finestra.riunione" => "Riunione"), @tr("programma.finestra.crea-tua-voce" => "Crea la tua voce"), @tr("programma.finestra.informazioni" => "Informazioni"), @tr("programma.finestra.svuota-cronologia" => "Svuota la cronologia")] : [@tr("programma.finestra.riunione" => "Riunione"), @tr("programma.finestra.crea-tua-voce" => "Crea la tua voce"), @tr("programma.finestra.informazioni" => "Informazioni")])
            : (root.history.length > 0 ? [@tr("programma.finestra.crea-tua-voce" => "Crea la tua voce"), @tr("programma.finestra.informazioni" => "Informazioni"), @tr("programma.finestra.svuota-cronologia" => "Svuota la cronologia")] : [@tr("programma.finestra.crea-tua-voce" => "Crea la tua voce"), @tr("programma.finestra.informazioni" => "Informazioni")]);
        x: root.width - self.width - Token.spazio-medio * Aspetto.scala;
        y: Token.altezza-barra * Aspetto.scala - Token.spostamento-entrata / 2 * (1 - self.fase);
        width: min(root.width - 2 * Token.spazio-medio * Aspetto.scala, Token.bolla-larghezza * Aspetto.scala / 2.2);
        scelta(i) => {
            root.menu-altro-aperto = false;
            if (root.minima && i == 0) { root.compatta = true; root.compatta-cambiata(true); scrittura.focus(); }
            else {
                // the item's place among «Crea la tua voce», «Informazioni», «Svuota la cronologia»
                if (i - (root.minima ? 1 : 0) == 0) { root.apri-crea-voce(); root.schermata = Schermata.crea-voce; }
                else if (i - (root.minima ? 1 : 0) == 1) { root.apri-informazioni(); }
                else { root.apri-conferma(); }
            }
        }
        chiudi => { root.chiudi-altro(); }
    }

    informazioni := Informazioni {
        x: 0; y: 0; width: root.width; height: root.height;
        aperta: root.info-aperta;
        versione: root.version;
        apri-sito => { root.apri-sito(); }
        chiusa => { root.chiudi-informazioni(); }
    }
    conferma-svuota := Conferma {
        x: 0; y: 0; width: root.width; height: root.height;
        aperta: root.conferma-aperta;
        titolo: @tr("programma.finestra.svuotare-cronologia" => "Svuotare la cronologia?");
        testo: @tr("programma.finestra.frasi-gia-dette-spariscono" => "Le frasi già dette spariscono da questo computer. Non si può tornare indietro.");
        conferma-testo: @tr("programma.finestra.svuota" => "Svuota");
        confermato => { root.svuota-cronologia(); root.chiudi-conferma(); scrittura.focus(); }
        annullato => { root.chiudi-conferma(); }
    }
    }
}
