// The writing: a large bubble with the dashed outline of what is not yet said. Enter says it; there are no new lines.
// It takes the room the window has (Finestra gives it the larger share); its minimum is a number of lines, never a band.
import { Token } from "token.slint";
import { Aspetto } from "aspetto.slint";
import { Tratteggio, Pulsante, Tipo } from "forme.slint";

export component Scrittura inherits Rectangle {
    in-out property <string> testo;
    // the voice can take a phrase now
    in property <bool> pronta: true;
    // the voice is speaking: «Ferma» shows
    in property <bool> parla: false;
    // the voice is getting ready: the dashes walk
    in property <bool> prepara: false;
    // the last phrase said: ↑ in the empty field brings it back
    in property <string> ultima;
    // the gathered arrangement (meeting mode, a low window): smaller writing, short hint, small commands
    in property <bool> compatta: false;
    // what the empty field says: it follows the state of the voice, it never promises what the voice cannot do now
    in property <string> segnaposto: root.compatta ? @tr("Scrivi qui.") : @tr("Scrivi qui. Invio la dice.");
    // for the catalog: show the focused look without focus
    in property <bool> mostra-fuoco: false;
    callback dici(string) -> bool;
    callback ferma();
    out property <bool> ha-fuoco: campo.has-focus;
    property <length> corpo: (root.compatta ? Token.corpo-scrittura-raccolta : Token.corpo-scrittura) * Aspetto.scala;
    property <length> aria: (root.compatta ? Token.spazio-controlli : Token.spazio-largo) * Aspetto.scala;
    property <bool> acceso: campo.has-focus || root.mostra-fuoco;
    property <bool> ha-testo: root.testo != "";
    property <int> righe: root.compatta ? Token.righe-scrittura-raccolta : Token.righe-scrittura;
    forward-focus: campo;
    min-height: root.aria * 1.5 + root.righe * root.corpo * Token.interlinea + comandi.height;
    background: Token.campo;
    border-radius: Token.raggio-scrittura * Aspetto.scala;

    function invia() {
        if (root.pronta && root.ha-testo && root.dici(root.testo)) {
            root.testo = "";
        }
        campo.focus();
    }

    Tratteggio {
        width: 100%; height: 100%;
        raggio: Token.raggio-scrittura * Aspetto.scala;
        // the voice cannot speak at all: the place of what is not yet said goes quiet
        colore: !root.pronta && !root.prepara ? Token.bordo-comando : root.acceso ? Token.tratteggio-fuoco : Token.tratteggio;
        cammino: root.prepara && !Aspetto.movimento-ridotto ? mod(animation-tick() / Token.durata-cammino, 1) : 0;
        animate colore { duration: Token.durata-scurisce; easing: Token.curva-dolce; }
    }
    // what is written stays inside its place: it never runs under the commands
    Rectangle {
        x: root.aria; y: root.aria * 0.8;
        width: root.width - 2 * root.aria;
        height: max(0px, root.height - self.y - comandi.height - root.aria * 0.7);
        clip: true;
        // a long phrase scrolls inside its place and follows the cursor, as the text being written must stay in view
        scorre := Flickable {
            x: 0; y: 0;
            width: parent.width;
            height: parent.height;
            content-width: self.width;
            content-height: max(self.height, campo.preferred-height);
            tasti := FocusScope {
                // it only listens for Enter, Esc and ↑ around the field: Tab goes to the field itself
                focus-on-tab-navigation: false;
                x: 0; y: 0;
                width: scorre.width;
                height: scorre.content-height;
                capture-key-pressed(e) => {
                    if (e.text == Key.Return) { root.invia(); return accept; }
                    if (e.text == Key.Escape) { root.ferma(); return accept; }
                    if (e.text == Key.UpArrow && !root.ha-testo && root.ultima != "") { root.testo = root.ultima; return accept; }
                    return reject;
                }
                campo := TextInput {
                    width: 100%; height: 100%;
                    single-line: false;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    font-size: root.corpo;
                    font-weight: Token.peso-testo;
                    color: Token.testo;
                    selection-background-color: Token.velo-premuto;
                    selection-foreground-color: Token.testo;
                    text-cursor-width: Token.tratto;
                    text <=> root.testo;
                    accessible-label: @tr("Che cosa vuoi dire");
                    cursor-position-changed(punto) => {
                        if (punto.y + self.font-size * Token.interlinea > -scorre.content-y + scorre.height) {
                            scorre.content-y = -(punto.y + self.font-size * Token.interlinea - scorre.height);
                        }
                        if (punto.y < -scorre.content-y) {
                            scorre.content-y = -punto.y;
                        }
                    }
                }
                if !root.ha-testo: Text {
                    x: 0; y: 0;
                    width: 100%;
                    text: root.segnaposto;
                    wrap: word-wrap;
                    vertical-alignment: top;
                    font-size: root.corpo;
                    color: Token.segnaposto;
                }
            }
        }
    }
    comandi := HorizontalLayout {
        x: root.aria; y: root.height - self.height - root.aria * 0.7;
        width: root.width - 2 * root.aria;
        height: (root.compatta ? Token.altezza-comando-piccolo : Token.altezza-comando) * Aspetto.scala;
        spacing: Token.spazio-controlli * Aspetto.scala;
        Text {
            // the keys are promised only when the voice can take the phrase
            visible: root.pronta && !root.compatta && root.width > Token.soglia-minima * Aspetto.scala * 0.85;
            text: root.ultima != "" ? @tr("Invio la dice · Esc la ferma · ↑ l'ultima frase") : @tr("Invio la dice · Esc la ferma");
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
            font-size: Token.corpo-nota * Aspetto.scala;
            color: Token.testo-tenue;
        }
        if root.parla: Pulsante {
            testo: @tr("Ferma");
            tasto: root.compatta ? "" : @tr("Esc");
            tipo: Tipo.quieto;
            piccolo: root.compatta;
            premuto => { root.ferma(); campo.focus(); }
        }
        Pulsante {
            testo: @tr("Di'");
            tasto: @tr("Invio");
            tipo: Tipo.pieno;
            piccolo: root.compatta;
            abilitato: root.pronta && root.ha-testo;
            premuto => { root.invia(); }
        }
    }
}
