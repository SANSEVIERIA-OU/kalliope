// The status line: it always tells the truth about the voice, in words, with a sign that moves only while the voice speaks.
import { Token } from "token.slint";
import { Aspetto, Situazione } from "aspetto.slint";
import { Punto } from "forme.slint";

// The bars of «Tu» from the home page: they breathe while the voice speaks, and lie flat otherwise.
export component BarreVoce inherits Rectangle {
    in property <bool> attiva: true;
    in property <color> colore: Token.voce;
    in property <float> grandezza: 1;
    property <length> passo: Token.barra-voce * 2 * root.grandezza * Aspetto.scala;
    property <length> alta: Token.barra-voce-alta * root.grandezza * Aspetto.scala;
    property <bool> vive: root.attiva && !Aspetto.movimento-ridotto;
    width: 4 * root.passo - Token.barra-voce * root.grandezza * Aspetto.scala;
    height: root.alta;
    for i in 4: Rectangle {
        property <float> onda: root.vive ? abs(sin(animation-tick() / Token.durata-barre * 0.5turn + i * 0.29turn)) : (root.attiva ? (i == 1 || i == 2 ? 1 : 0.55) : 0);
        x: i * root.passo;
        width: Token.barra-voce * root.grandezza * Aspetto.scala;
        height: Token.barra-voce * root.grandezza * Aspetto.scala + (root.alta - self.width) * self.onda;
        y: (root.alta - self.height) / 2;
        border-radius: self.width / 2;
        background: root.colore;
    }
}

// The short name of each state, and what the line says when the engine has no words of its own.
export component RigaStato inherits Rectangle {
    in property <Situazione> situazione: Situazione.preparazione;
    // the engine's own sentence (session.rs): used for every state that something must be done about
    in property <string> spiegazione;
    in property <bool> compatta: false;
    // a piece of good news (a voice was made) says itself in the line's place, in the colour of the action, and goes by itself
    in property <string> notizia;
    // a narrow window: the name of the state above, its explanation below, wrapped at the whole width
    in property <bool> impilata: false;
    property <bool> male: root.situazione == Situazione.nessuno-ascolta || root.situazione == Situazione.senza-microfono
        || root.situazione == Situazione.problema-voce || root.situazione == Situazione.avviso;
    property <bool> bene: root.notizia != "" && !root.male;
    property <string> titolo:
        root.bene ? @tr("programma.stato.voce-nuova" => "Voce nuova")
        : root.situazione == Situazione.preparazione ? @tr("programma.stato.preparo-la-voce" => "Preparo la voce")
        : root.situazione == Situazione.pronta ? @tr("programma.stato.pronta" => "Pronta")
        : root.situazione == Situazione.parla ? @tr("programma.stato.sto-parlando" => "Sto parlando")
        : root.situazione == Situazione.nessuno-ascolta ? @tr("programma.stato.nessuno-ti-sente" => "Nessuno ti sente")
        : root.situazione == Situazione.senza-microfono ? @tr("programma.stato.manca-microfono" => "Manca il microfono")
        : root.situazione == Situazione.problema-voce ? @tr("programma.stato.voce-non-parte" => "La voce non parte")
        : @tr("programma.stato.attenzione" => "Attenzione");
    property <string> detto:
        root.bene ? root.notizia
        : root.situazione == Situazione.preparazione ? @tr("programma.stato.fra-poco-puoi-scrivere" => "Fra poco puoi scrivere e farti sentire.")
        : root.situazione == Situazione.pronta ? @tr("programma.stato.nella-riunione-scegli-kalliope" => "Nella riunione scegli «Kalliope» come microfono.")
        : root.situazione == Situazione.parla ? @tr("programma.stato.esc-ferma" => "Esc la ferma.")
        : root.spiegazione;
    accessible-role: text;
    accessible-label: root.titolo + ". " + root.detto;
    // never squeezed below its words: the truth about the voice stays whole. When its words need more or fewer lines the row
    // changes height in the time of the history's slide (correction M-1), so the writing below does not drop in one frame.
    property <length> alto: max(Token.altezza-comando-piccolo * Aspetto.scala, riga.preferred-height);
    animate alto { duration: Aspetto.movimento-ridotto ? 0ms : Token.durata-bolla; easing: Token.curva-dolce; }
    min-height: root.alto;
    preferred-height: root.alto;
    clip: true;
    border-radius: Token.raggio-pannello * Aspetto.scala;
    background: root.male ? Token.attenzione-fondo : transparent;
    animate background { duration: Token.durata-scurisce; easing: Token.curva-dolce; }
    riga := HorizontalLayout {
        padding-left: (root.male ? Token.spazio-medio : Token.spazio-stretto) * Aspetto.scala;
        padding-right: Token.spazio-medio * Aspetto.scala;
        padding-top: Token.spazio-stretto * Aspetto.scala;
        padding-bottom: Token.spazio-stretto * Aspetto.scala;
        spacing: Token.spazio-controlli * Aspetto.scala;
        segno := Rectangle {
            width: Token.barra-voce-alta * Aspetto.scala;
            vertical-stretch: 0;
            if root.situazione == Situazione.parla: BarreVoce { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
            if root.situazione != Situazione.parla: Punto {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                colore: root.male ? Token.attenzione : Token.azione;
                // getting ready: the dot breathes, like the dashes that walk
                opacity: root.situazione == Situazione.preparazione && !Aspetto.movimento-ridotto
                    ? Token.opacita-spento + (1 - Token.opacita-spento) * abs(sin(animation-tick() / Token.durata-cammino * 0.5turn)) : 1;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: root.impilata || root.compatta ? 1 : 0;
            Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                text: root.titolo;
                vertical-alignment: center;
                font-size: Token.corpo-comando * Aspetto.scala;
                font-weight: Token.peso-forte;
                color: root.male ? Token.attenzione : root.bene ? Token.azione : Token.testo;
            }
            if root.impilata: Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
                text: root.detto;
                wrap: word-wrap;
                font-size: Token.corpo-stato * Aspetto.scala;
                color: Token.testo-tenue;
            }
        }
        // gathered: the state in a word (the whole sentence stays in the accessible label and in the full window)
        if !root.impilata && !root.compatta: Text { transform-scale-x: Token.verso; horizontal-alignment: Aspetto.inizio; line-height-factor: Aspetto.interlinea;
            text: root.detto;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: root.compatta ? no-wrap : word-wrap;
            overflow: elide;
            font-size: Token.corpo-stato * Aspetto.scala;
            color: Token.testo-tenue;
        }
        @children
    }
}
