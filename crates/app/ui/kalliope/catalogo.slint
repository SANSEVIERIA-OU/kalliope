// SPDX-License-Identifier: LicenseRef-SANSEVIERIA-1.1
// The live catalog of the window's design system (`kalliope --catalogo`): every token with its value and its source, every
// component in its states, every movement with a control to see it again. Made of the same tokens and components.
import { Palette, ScrollView } from "std-widgets.slint";
import { Token } from "token.slint";
import { Dati } from "catalogo_dati.slint";
import { Aspetto, Situazione } from "aspetto.slint";
import { Tratteggio, Pulsante, Tipo, Punto, Freccia, Interruttore } from "forme.slint";
import { RigaStato, BarreVoce } from "stato.slint";
import { BollaVoce, FraseDetta } from "bolla.slint";
import { Scrittura } from "scrittura.slint";
import { Passi, Livello, Registra, Consenso } from "voce-propria.slint";
import { Menu } from "menu.slint";

component Titolo inherits Text {
    font-size: Token.corpo-titolo * Aspetto.scala;
    font-weight: Token.peso-titolo;
    color: Token.testo;
    wrap: word-wrap;
}
component Nota inherits Text {
    font-size: Token.corpo-nota * Aspetto.scala;
    color: Token.testo-tenue;
    wrap: word-wrap;
}
component Etichetta inherits Text {
    font-size: Token.corpo-stato * Aspetto.scala;
    font-weight: Token.peso-forte;
    color: Token.testo;
}
// A frame for one example: its name above, its source below.
component Esempio inherits VerticalLayout {
    in property <string> nome;
    in property <string> fonte;
    spacing: Token.spazio-stretto * Aspetto.scala;
    Etichetta { text: root.nome; }
    @children
    if root.fonte != "": Nota { text: root.fonte; }
}

export component Catalogo inherits Window {
    title: "Kalliope · catalogo del design system della finestra";
    preferred-width: Token.native-width * 1.3;
    preferred-height: Token.native-height * 1.3;
    min-width: Token.native-min-width;
    min-height: Token.native-min-height;
    background: Token.fondo;
    default-font-family: Token.font-testo;
    // to replay each movement
    property <int> giro: 0;
    property <bool> avanti: true;
    property <duration> partenza-voce: 0ms;
    property <bool> voce-in-corso: false;
    property <length> px: 1px; // fisso: l'unità con cui il catalogo scrive una misura in parole
    property <string> frase: "Sono d'accordo con Paola. Però la consegna del 14/3 mi sembra stretta.";
    property <int> parole-frase: 13;
    property <[string]> prefissi: ["", "Sono", "Sono d'accordo", "Sono d'accordo con", "Sono d'accordo con Paola.", "Sono d'accordo con Paola. Però", "Sono d'accordo con Paola. Però la", "Sono d'accordo con Paola. Però la consegna", "Sono d'accordo con Paola. Però la consegna del", "Sono d'accordo con Paola. Però la consegna del 14/3", "Sono d'accordo con Paola. Però la consegna del 14/3 mi", "Sono d'accordo con Paola. Però la consegna del 14/3 mi sembra", "Sono d'accordo con Paola. Però la consegna del 14/3 mi sembra stretta."];
    property <duration> trascorso: root.voce-in-corso ? animation-tick() - root.partenza-voce : 0ms;
    property <int> dette: root.voce-in-corso ? min(root.parole-frase, floor(root.trascorso / Token.durata-parola)) : root.parole-frase;
    property <float> sfumatura: root.voce-in-corso && root.dette < root.parole-frase ? clamp((root.trascorso - root.dette * Token.durata-parola) / Token.durata-scurisce, 0, 1) : 0;
    property <bool> nata: true;

    Timer { interval: Token.durata-parola * 14; running: root.voce-in-corso; triggered => { root.voce-in-corso = false; } }
    rinasce := Timer { interval: Token.intervallo-fotogramma; running: false; triggered => { root.nata = true; self.running = false; } }

    ScrollView {
        VerticalLayout {
            padding: Token.spazio-ampio * Aspetto.scala;
            spacing: Token.spazio-ampio * Aspetto.scala;

            // Identity and controls
            VerticalLayout {
                spacing: Token.spazio-controlli * Aspetto.scala;
                HorizontalLayout {
                    spacing: Token.spazio-controlli * Aspetto.scala;
                    Image { source: @image-url("../../../../design-system/marchio/libero.svg"); width: Token.marchio * 1.6 * Aspetto.scala; height: self.width; }
                    Titolo { text: "La finestra di Kalliope · «La frase che si accende»"; vertical-alignment: center; }
                }
                Nota {
                    text: "Proposta del 26/11/2026, non ancora approvata. Scrivi nella bolla tratteggiata del non ancora detto; Invio la manda nella bolla dove la voce la dice, una parola dopo l'altra; la frase detta resta, piena, da ripetere. Ogni valore viene da design-system/token.css (--app-*), generato per Slint: la tabella dei token qui sotto è generata anche lei.";
                }
                HorizontalLayout {
                    spacing: Token.spazio-medio * Aspetto.scala;
                    alignment: start;
                    Pulsante { testo: Token.dark ? "Tema: scuro" : "Tema: chiaro"; tipo: Tipo.quieto; piccolo: true; premuto => { Palette.color-scheme = Token.dark ? ColorScheme.light : ColorScheme.dark; } }
                    Pulsante { testo: "A−"; tipo: Tipo.nudo; piccolo: true; abilitato: Aspetto.scala > 1; premuto => { Aspetto.scala = max(1, Aspetto.scala - Token.scala-passo); } }
                    Text { text: round(Aspetto.scala * 100) + "%"; vertical-alignment: center; color: Token.testo-tenue; font-size: Token.corpo-nota * Aspetto.scala; }
                    Pulsante { testo: "A+"; tipo: Tipo.nudo; piccolo: true; abilitato: Aspetto.scala < Token.scala-massima; premuto => { Aspetto.scala = min(Token.scala-massima, Aspetto.scala + Token.scala-passo); } }
                    Interruttore { testo: "Movimento ridotto"; acceso <=> Aspetto.movimento-ridotto; }
                }
            }

            // Colours, both themes side by side
            VerticalLayout {
                spacing: Token.spazio-medio * Aspetto.scala;
                Titolo { text: "Colori e materiali · scuro e chiaro"; }
                Nota { text: "A sinistra il tema scuro (:root), a destra il chiaro (:root[data-tema=\"chiaro\"]). Il tema della finestra segue il sistema; il pulsante «Tema» qui sopra lo cambia per provarlo."; }
                for c in Dati.colori: HorizontalLayout {
                    spacing: Token.spazio-medio * Aspetto.scala;
                    Rectangle {
                        width: Token.altezza-comando * 2 * Aspetto.scala; height: Token.altezza-comando * Aspetto.scala;
                        border-radius: Token.raggio-coda * Aspetto.scala; border-width: Token.filo; border-color: Token.bordo;
                        clip: true;
                        Rectangle { x: 0; width: parent.width / 2; background: c.scuro; }
                        Rectangle { x: parent.width / 2; width: parent.width / 2; background: c.chiaro; }
                    }
                    VerticalLayout {
                        alignment: center;
                        Etichetta { text: "--app-" + c.nome; }
                        Nota { text: c.fonte; }
                    }
                }
            }

            // Type
            VerticalLayout {
                spacing: Token.spazio-medio * Aspetto.scala;
                Titolo { text: "Caratteri e scala del testo"; }
                Nota { text: "Lexend (OFL), il carattere del sito: forme tonde e aperte, disegnato per la scorrevolezza della lettura. Pesi 400, 500, 600, 700. Ogni grandezza cresce con il testo regolabile (100–200%)."; }
                Esempio { nome: "corpo-scrittura · 30 px · ciò che si scrive"; Text { text: "Possiamo sentirci venerdì alle 15:30?"; font-size: Token.corpo-scrittura * Aspetto.scala; color: Token.testo; wrap: word-wrap; } }
                Esempio { nome: "corpo-lettura · 34 px · il testo da leggere per la voce propria"; Text { text: "Ciao, sono io. Questa è la mia voce."; font-size: Token.corpo-lettura * Aspetto.scala; font-weight: Token.peso-medio; color: Token.testo; wrap: word-wrap; } }
                Esempio { nome: "corpo-titolo · 28 px · peso-titolo"; Text { text: "Come vuoi creare la tua voce?"; font-size: Token.corpo-titolo * Aspetto.scala; font-weight: Token.peso-titolo; color: Token.testo; wrap: word-wrap; } }
                Esempio { nome: "corpo-bolla · 24 px · peso-medio"; Text { text: "Sono d'accordo con Paola."; font-size: Token.corpo-bolla * Aspetto.scala; font-weight: Token.peso-medio; color: Token.testo; } }
                Esempio { nome: "corpo-marchio 18 · corpo-detta 17 · corpo-comando 16 · corpo-stato 15 · corpo-nota 13"; HorizontalLayout { spacing: Token.spazio-largo * Aspetto.scala; alignment: start;
                    Text { text: "Kalliope"; font-size: Token.corpo-marchio * Aspetto.scala; font-weight: Token.peso-forte; color: Token.testo; }
                    Text { text: "Già detta"; font-size: Token.corpo-detta * Aspetto.scala; color: Token.testo-tenue; }
                    Text { text: "Comando"; font-size: Token.corpo-comando * Aspetto.scala; font-weight: Token.peso-medio; color: Token.testo; }
                    Text { text: "Stato"; font-size: Token.corpo-stato * Aspetto.scala; color: Token.testo-tenue; }
                    Text { text: "Nota"; font-size: Token.corpo-nota * Aspetto.scala; color: Token.testo-tenue; } } }
            }

            // Lengths
            VerticalLayout {
                spacing: Token.spazio-stretto * Aspetto.scala;
                Titolo { text: "Spazi, misure e raggi"; }
                for m in Dati.misure: HorizontalLayout {
                    spacing: Token.spazio-medio * Aspetto.scala;
                    Rectangle {
                        width: Token.bolla-larghezza / 3;
                        height: Token.spazio-largo;
                        Rectangle { x: 0; width: min(parent.width, m.misura); height: min(parent.height, max(Token.tratto, m.misura / 4)); y: (parent.height - self.height) / 2; background: Token.voce; border-radius: self.height / 2; }
                    }
                    Etichetta { text: m.nome + " · " + m.testo; vertical-alignment: center; min-width: Token.bolla-larghezza / 3; }
                    Nota { text: m.fonte; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }

            // Other values: weights, scales, curves, typeface
            VerticalLayout {
                spacing: Token.spazio-stretto * Aspetto.scala;
                Titolo { text: "Pesi, rapporti, curve e carattere"; }
                for a in Dati.altri: HorizontalLayout {
                    spacing: Token.spazio-medio * Aspetto.scala;
                    Etichetta { text: a.nome + " · " + a.testo; min-width: Token.bolla-larghezza / 2; }
                    Nota { text: a.fonte; horizontal-stretch: 1; }
                }
            }

            // Movement
            VerticalLayout {
                spacing: Token.spazio-medio * Aspetto.scala;
                Titolo { text: "Movimento"; }
                Nota { text: "Ogni durata con il suo comando: «Rivedi» muove il punto per quella durata, avanti e indietro, con la curva d'entrata del sito (cubic-bezier(0.19, 1, 0.22, 1)). Sotto, i movimenti veri della finestra."; }
                HorizontalLayout { alignment: start; Pulsante { testo: "Rivedi tutte le durate"; tipo: Tipo.pieno; piccolo: true; premuto => { root.avanti = !root.avanti; } } }
                for d in Dati.tempi: HorizontalLayout {
                    spacing: Token.spazio-medio * Aspetto.scala;
                    Rectangle {
                        width: Token.bolla-larghezza / 2; height: Token.spazio-largo;
                        Rectangle { y: (parent.height - self.height) / 2; height: Token.filo; background: Token.bordo; }
                        Punto {
                            y: (parent.height - self.height) / 2;
                            x: root.avanti ? 0 : parent.width - self.width;
                            colore: Token.azione;
                            animate x { duration: d.durata; easing: Token.curva-entrata; }
                        }
                    }
                    Etichetta { text: d.nome + " · " + d.testo; vertical-alignment: center; min-width: Token.bolla-larghezza / 3; }
                    Nota { text: d.fonte; vertical-alignment: center; horizontal-stretch: 1; }
                }
                Esempio {
                    nome: "La bolla nasce dalla coda (520 ms, curva d'entrata) e le parole si scuriscono una ogni 0,36 s (200 ms ciascuna)";
                    fonte: "Fonte: la home del sito (D2) e la sua misura: 17 parole in 6085 ms. Nella finestra vera il ritmo è una stima: il motore dice quando una frase comincia e finisce, non dove sta ogni parola.";
                    HorizontalLayout { alignment: start; spacing: Token.spazio-medio * Aspetto.scala;
                        Pulsante { testo: "Rivedi la frase detta"; tipo: Tipo.quieto; piccolo: true; premuto => { root.nata = false; rinasce.running = true; root.partenza-voce = animation-tick(); root.voce-in-corso = true; } }
                    }
                    Rectangle {
                        height: Token.altezza-comando * 3 * Aspetto.scala;
                        BollaVoce {
                            x: Token.ombra-sfocatura; y: parent.height - self.height - Token.ombra-sfocatura;
                            testo: root.frase;
                            detto: root.prefissi[root.dette];
                            dicendo: root.prefissi[min(root.parole-frase, root.dette + 1)];
                            sfumatura: root.sfumatura;
                            parla: root.voce-in-corso;
                            nascita: root.nata || Aspetto.movimento-ridotto ? 1 : 0;
                            animate nascita { duration: root.nata && !Aspetto.movimento-ridotto ? Token.durata-bolla : 0ms; easing: Token.curva-entrata; }
                        }
                    }
                }
                Esempio {
                    nome: "Le barre della voce respirano mentre la voce parla (460 ms); il tratteggio cammina mentre la voce si prepara (1,4 s)";
                    fonte: "Con «Movimento ridotto» restano ferme: le barre alte nel mezzo, il tratteggio fermo, la bolla che compare senza crescere.";
                    HorizontalLayout { alignment: start; spacing: Token.spazio-largo * Aspetto.scala;
                        BarreVoce { attiva: true; grandezza: 2; }
                        BarreVoce { attiva: false; grandezza: 2; }
                        Rectangle { width: Token.bolla-larghezza / 3; height: Token.altezza-comando * 1.5 * Aspetto.scala;
                            Tratteggio { width: 100%; height: 100%; raggio: Token.raggio-pannello * Aspetto.scala; cammino: Aspetto.movimento-ridotto ? 0 : mod(animation-tick() / Token.durata-cammino, 1); }
                        }
                    }
                }
            }

            // Components
            VerticalLayout {
                spacing: Token.spazio-largo * Aspetto.scala;
                Titolo { text: "Componenti, in tutti i loro stati"; }
                Esempio {
                    nome: "Pulsante · pieno, quieto, nudo · riposo, sopra, premuto, fuoco, spento";
                    fonte: "Pillole del sito; un solo pieno per schermata (l'azione, menta). Il fuoco è l'anello della voce, 3 px.";
                    for t in [Tipo.pieno, Tipo.quieto, Tipo.nudo]: HorizontalLayout { alignment: start; spacing: Token.spazio-medio * Aspetto.scala;
                        Pulsante { testo: "Di'"; tasto: "Invio"; tipo: t; }
                        Pulsante { testo: "Sopra"; tipo: t; mostra-sopra: true; }
                        Pulsante { testo: "Premuto"; tipo: t; mostra-premuto: true; }
                        Pulsante { testo: "Fuoco"; tipo: t; mostra-fuoco: true; }
                        Pulsante { testo: "Spento"; tipo: t; abilitato: false; }
                    }
                }
                Esempio {
                    nome: "Riga di stato · i sette stati veri";
                    fonte: "Dice sempre la verità: dai segnali del motore (session.rs, Status::situation). Il caldo è la tinta dei partecipanti approvata, il solo colore caldo della finestra.";
                    RigaStato { situazione: Situazione.preparazione; }
                    RigaStato { situazione: Situazione.pronta; }
                    RigaStato { situazione: Situazione.parla; }
                    RigaStato { situazione: Situazione.nessuno-ascolta; spiegazione: "Nessuno nella chiamata ha sentito la frase: nessuna app sta usando il microfono «Kalliope»."; }
                    RigaStato { situazione: Situazione.senza-microfono; spiegazione: "La voce è pronta, ma il microfono virtuale «Kalliope» non c'è: per ora nessuno ti sentirà nelle chiamate."; }
                    RigaStato { situazione: Situazione.problema-voce; spiegazione: "Non trovo i file della voce. Reinstalla Kalliope dal pacchetto."; }
                    RigaStato { situazione: Situazione.avviso; spiegazione: "Non c'è niente da dire in questo testo: scrivi almeno una parola, poi premi Invio."; }
                }
                Esempio {
                    nome: "Bolla della voce · detta, mentre parla, quando nessuno la sente · frase già detta, a riposo e al passaggio";
                    fonte: "La bolla chiara della home (coda in basso all'inizio, come nel logo); nel tema chiaro è grafite: sempre il contrario della stanza.";
                    HorizontalLayout { alignment: start; spacing: Token.spazio-largo * Aspetto.scala; padding: Token.ombra-sfocatura;
                        BollaVoce { testo: "Ho letto il documento."; detto: "Ho letto il documento."; dicendo: ""; larghezza-massima: Token.bolla-larghezza / 2; }
                        BollaVoce { testo: "Ho letto il documento."; detto: "Ho letto"; dicendo: "Ho letto il"; sfumatura: 0.5; parla: true; larghezza-massima: Token.bolla-larghezza / 2; }
                        BollaVoce { testo: "Ho letto il documento."; detto: "Ho letto il"; dicendo: ""; parla: true; non-sentita: true; larghezza-massima: Token.bolla-larghezza / 2; }
                    }
                    HorizontalLayout { alignment: start; spacing: Token.spazio-medio * Aspetto.scala;
                        FraseDetta { testo: "Per me va bene la seconda proposta."; }
                        FraseDetta { testo: "Scusate, posso aggiungere una cosa?"; abilitata: false; }
                    }
                }
                Esempio {
                    nome: "Scrittura · vuota, con il fuoco, mentre la voce si prepara (il tratteggio cammina), con testo e Ferma";
                    fonte: "La metà tratteggiata del logo (tratteggio 14/10, tratto 3 px) attorno alla scrittura: il non ancora detto. Invio la dice, Esc la ferma, ↑ riporta l'ultima frase.";
                    HorizontalLayout { spacing: Token.spazio-medio * Aspetto.scala;
                        Scrittura { height: self.min-height; }
                        Scrittura { height: self.min-height; mostra-fuoco: true; }
                    }
                    HorizontalLayout { spacing: Token.spazio-medio * Aspetto.scala;
                        Scrittura { height: self.min-height; prepara: true; pronta: false; }
                        Scrittura { height: self.min-height; testo: "Possiamo sentirci venerdì alle 15:30?"; parla: true; ultima: "Ho letto il documento."; }
                    }
                }
                Esempio {
                    nome: "Bolla su una riga · nella modalità riunione e nella finestra più piccola la riga scorre e tiene in vista la parola detta";
                    fonte: "Correzione I3 dopo il giudizio: anche nella riunione si vede che cosa dice la voce.";
                    HorizontalLayout { alignment: start; padding: Token.ombra-sfocatura;
                        BollaVoce { testo: root.frase; detto: root.prefissi[root.dette]; dicendo: root.prefissi[min(root.parole-frase, root.dette + 1)]; sfumatura: root.sfumatura; parla: root.voce-in-corso; riga-sola: true; larghezza-massima: Token.compatta-larghezza * Aspetto.scala; }
                    }
                }
                Esempio {
                    nome: "Menu · aperto, con la voce in uso e una voce evidenziata dalle frecce";
                    fonte: "Correzione B2: ↑ ↓ spostano, Invio o Spazio scelgono, Esc chiude e riporta il fuoco sul pulsante. Il fuoco entra nel menu quando si apre.";
                    Rectangle { height: catalogo-menu.height + Token.ombra-sfocatura * 2;
                        catalogo-menu := Menu { x: Token.ombra-sfocatura; y: Token.ombra-sfocatura; width: Token.bolla-larghezza / 2; aperto: true; titolo: "Con quale voce parli"; voci: ["Giulia", "Marco", "La voce di Anna"]; tinte: [Token.tinta-voce-1, Token.tinta-voce-2, Token.tinta-propria]; in-uso: 0; evidenziata: 2; }
                    }
                }
                Esempio {
                    nome: "Voci come partecipanti · punto della tinta · interruttore spento e acceso · freccia di un menu";
                    fonte: "Le tinte dei riquadri della riunione del sito: Giulia (Anna), Marco (Luca), la voce propria («Tu»), un'altra voce propria (il grigio verde delle barre spente). La tinta calda di Paola resta solo all'avviso.";
                    HorizontalLayout { alignment: start; spacing: Token.spazio-medio * Aspetto.scala;
                        Punto { colore: Token.tinta-voce-1; lato: Token.spazio-largo * Aspetto.scala; }
                        Punto { colore: Token.tinta-voce-2; lato: Token.spazio-largo * Aspetto.scala; }
                        Punto { colore: Token.tinta-propria; lato: Token.spazio-largo * Aspetto.scala; }
                        Punto { colore: Token.tinta-voce-3; lato: Token.spazio-largo * Aspetto.scala; }
                        Interruttore { testo: "Spento"; acceso: false; }
                        Interruttore { testo: "Acceso"; acceso: true; }
                        Freccia { }
                    }
                }
                Esempio {
                    nome: "Voce propria · passi, livello fermo e vivo, registra e ferma con il cerchio dei dodici secondi (a metà, pieno), consenso";
                    fonte: "Passi con tre stati (da ElevenLabs IVC); il tondo «registra» ha il rosa del logo; il livello è fatto delle barre della voce.";
                    Passi { passo: 1; }
                    Livello { attivo: false; }
                    Livello { attivo: true; }
                    HorizontalLayout { alignment: start; spacing: Token.spazio-largo * Aspetto.scala;
                        Registra { registra: false; }
                        Registra { registra: true; avanzamento: 0.6; }
                        Registra { registra: true; avanzamento: 1; }
                    }
                    Consenso { testo: "È la mia voce, oppure la persona che parla mi ha dato il permesso di usarla."; dato: false; }
                    Consenso { testo: "Spuntato"; dato: true; }
                }
            }
        }
    }
}
