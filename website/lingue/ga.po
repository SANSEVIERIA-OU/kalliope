msgid "<1>In riunione,</1> <2>alla pari.</2> <3>Tu scrivi, gli altri</3> <4>ti sentono.</4>"
msgstr "<1>Sa chruinniú,</1> <2>ar comhchéim.</2> <3>Scríobhann tú.</3> <4>Cloiseann na daoine eile thú.</4>"

#: index.html
