msgstr "Jak nainstalovat Kalliope<1/>"

#: stato/index.html
#, kalliope-markup
msgctxt "st.inoltra.senza-js"
msgid "Seleziona il testo della bolla e copialo, o manda l'indirizzo di questa pagina."
msgstr "Označte text v bublině a zkopírujte ho, případně pošlete adresu této stránky."

