msgid "Copia il messaggio"
msgstr "Copiar a mensagem"

#: stato/index.html
#, kalliope-markup
msgctxt "st.inoltra.fatto"
msgid "Copiato: incollalo in un messaggio o in una e‑mail."
msgstr "Texto copiado. Cola-o numa mensagem ou num e-mail."

#: stato/index.html
#, kalliope-markup
msgctxt "st.inoltra.errore"
msgid "Non riesco a copiarlo: seleziona il testo della bolla e copialo, o manda l'indirizzo di questa pagina."
msgstr "Não consegui copiar o texto. Seleciona o texto do balão e copia-o ou envia o endereço desta página."

