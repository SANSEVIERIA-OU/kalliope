msgctxt "apertura.titolo"
msgid "<1>In riunione,</1> <2>alla pari.</2> <3>Tu scrivi, gli altri</3> <4>ti sentono.</4>"
msgstr "<1>Na reunião,</1> <2>de igual para igual.</2> <3>Tu escreves,</3> <4>os outros ouvem-te.</4>"

#: index.html
#, kalliope-markup
msgctxt "apertura.presentazione"
msgid "Un programma per chi non può parlare o fa fatica. Scrivi una frase e premi Invio: una voce italiana naturale la dice nella riunione."
msgstr "Um programa para quem não consegue falar ou tem dificuldade em falar. Escreve uma frase e carrega em Enter. Uma voz natural diz a frase em italiano na reunião."

