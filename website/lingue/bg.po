#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.preparo-la-voce"
msgid "Preparo la voce"
msgstr "Подготвям гласа"

#. The name of the state when the voice is ready to speak. One word; it refers to the voice (feminine in Italian).
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.pronta"
msgid "Pronta"
msgstr "Готово"

#. The name of the state while the voice speaks, said by Kalliope: «I am speaking». Two words.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.sto-parlando"
msgid "Sto parlando"
msgstr "Говоря"

#. The name of the state when no app in the call uses the «Kalliope» microphone: the others cannot hear the person. Short.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.nessuno-ti-sente"
msgid "Nessuno ti sente"
msgstr "Никой не те чува"

#. The name of the state when the virtual microphone «Kalliope» could not be created. Short.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.manca-microfono"
msgid "Manca il microfono"
msgstr "Липсва микрофон"

#. The name of the state when the voice cannot start. Short.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.voce-non-parte"
msgid "La voce non parte"
msgstr "Гласът не тръгва"

#. The name of the state for any other problem: one word, as on a warning sign.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.attenzione"
msgid "Attenzione"
msgstr "Внимание"

#. What the status line says while the voice loads.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.fra-poco-puoi-scrivere"
msgid "Fra poco puoi scrivere e farti sentire."
msgstr "След малко ще можеш да пишеш, а другите ще те чуват."

#. What the status line says when the voice is ready: how to be heard. «Kalliope» in quotes is the name of the microphone to choose in the meeting app.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.nella-riunione-scegli-kalliope"
msgid "Nella riunione scegli «Kalliope» come microfono."
msgstr "В срещата избери „Kalliope“ за микрофон."

#. What the status line says while the voice speaks: the Esc key stops it. Short.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.esc-ferma"
msgid "Esc la ferma."
msgstr "Натисни Esc, за да спреш гласа."

#. The name of the first of the three steps of creating a voice, shown in a row at the top: record or import. Short.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.passo-scegli"
msgid "Registra o importa"
msgstr "Запис или файл"

#. The name of the second step: the person reads a text aloud. Short.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.passo-leggi"
msgid "Leggi ad alta voce"
msgstr "Прочети на глас"

#. The name of the third step: listen to the voice and give it a name. Short.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.passo-nome"
msgid "Ascolta e dai un nome"
msgstr "Чуй гласа и му дай име"

