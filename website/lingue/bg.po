msgstr "Enter"

#. The title of the status line just after a new voice is ready.
#: crates/app/ui/kalliope/stato.slint
#, kalliope-slint
msgctxt "programma.stato.voce-nuova"
msgid "Voce nuova"
msgstr "Нов глас"

