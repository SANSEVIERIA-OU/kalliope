#, kalliope-markup
msgctxt "st.varco.gia"
msgid "Già detto"
msgstr "Déjà prononcé"

#: stato/index.html
#, kalliope-markup
msgctxt "st.varco.memoria"
msgid "solo su questo computer"
msgstr "uniquement sur cet ordinateur"

#: stato/index.html
#, kalliope-markup
