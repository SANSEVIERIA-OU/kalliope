msgid_plural "Ho trovato {n} tratti in cui si sente la voce. Ascolta e scegli."
msgstr[0] "Sibt {n} parti bil-vuċi. Ismagħha u agħżel."
msgstr[1] "Partijiet bil-vuċi li sibt: {n}. Ismagħhom u agħżel."
msgstr[2] "Sibt {n} partijiet bil-vuċi. Ismagħhom u agħżel."
