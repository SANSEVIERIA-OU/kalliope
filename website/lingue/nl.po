#: stato/index.html
#, kalliope-markup
msgctxt "st.inoltra.installa"
msgid "Come si installa<1/>"
msgstr "Zo installeer je Kalliope<1/>"

#: stato/index.html
#, kalliope-markup
msgctxt "st.inoltra.senza-js"
msgid "Seleziona il testo della bolla e copialo, o manda l'indirizzo di questa pagina."
msgstr "Selecteer de tekst in de tekstballon en kopieer die, of stuur het adres van deze pagina."

