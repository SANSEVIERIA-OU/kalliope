msgstr "hanya di komputer ini"

#: stato/index.html
#, kalliope-markup
msgctxt "st.varco.disco"
msgid "Sul disco"
msgstr "Di penyimpanan"

#: stato/index.html
#, kalliope-markup
msgctxt "st.varco.programma"
