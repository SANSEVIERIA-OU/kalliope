msgctxt "barra.lingua"
msgid "Cambia lingua"
msgstr "Cambiar de idioma"

#: index.html
#, kalliope-markup
msgctxt "cta.scarica"
msgid "Scarica e installa"
msgstr "Descargar e instalar"

