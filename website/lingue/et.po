msgctxt "in.inoltra.titolo"
msgid "Lo installa un'altra persona?"
msgstr "Kas paigaldab keegi teine?"

#: installa/index.html
#, kalliope-markup
msgctxt "in.inoltra.testo"
msgid "Mandale l'indirizzo di questa pagina: trova i passi e i comandi da copiare."
msgstr "Saada talle selle lehe aadress. Siit leiab ta juhised ja käsud, mida kopeerida."

#: installa/index.html
#, kalliope-markup
msgctxt "in.inoltra.copia"
msgid "Copia l'indirizzo"
msgstr "Kopeeri aadress"

#: installa/index.html
#, kalliope-markup
msgctxt "in.inoltra.fatto"
msgid "Copiato: incollalo in un messaggio."
msgstr "Aadress on kopeeritud. Kleebi see sõnumisse."

#: installa/index.html
#, kalliope-markup
msgctxt "in.inoltra.errore"
msgid "Non riesco a copiarlo: seleziona l'indirizzo e copialo."
msgstr "Ma ei saa aadressi kopeerida. Vali aadress ja kopeeri see ise."

