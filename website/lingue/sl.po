#. Placeholders: {} or {0} {1}… are the arguments, in order; {n} is the count of a plural. Leave them as they are; a translation may reorder them.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint, python-brace-format
msgctxt "programma.crea.leggo"
msgid "Leggo «{}»…"
msgstr "Berem »{}«…"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.cerco-parte-cui-si"
msgid "Cerco la parte in cui si sente meglio la voce."
msgstr "Iščem del, kjer se glas najbolje sliši."

#. A small line over the first choice: this way is for a person who can still speak.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.se-hai-ancora-voce"
msgid "Se hai ancora la voce"
msgstr "Če še lahko govoriš"

#. The first choice for creating a voice: record it now, reading a short text aloud («la» is the voice). A title.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.registrala-adesso"
msgid "Registrala adesso"
msgstr "Posnemi svoj glas zdaj"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.istruzioni-registra"
msgid "Leggi ad alta voce un breve testo. Bastano dodici secondi di voce chiara, meglio finché la voce è forte."
msgstr "Na glas preberi kratko besedilo. Dovolj je dvanajst sekund razločnega govora. Najbolje je, da se posnameš, dokler je tvoj glas še močan."

#. A small line over the second choice: this way is for a person who can no longer speak.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.se-voce-non-c"
msgid "Se la voce non c'è più"
msgstr "Če ne moreš več govoriti"

#. The second choice: create the voice from recordings made before (voice messages, videos). A title.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.usa-vecchie-registrazioni"
msgid "Usa vecchie registrazioni"
msgstr "Uporabi stare posnetke"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.messaggio-vocale-video-registrazione"
msgid "Un messaggio vocale, un video, una registrazione di prima: WAV, FLAC, MP3, OGG, OPUS, M4A, MP4 o WEBM."
msgstr "Glasovno sporočilo, video ali starejši zvočni posnetek v obliki WAV, FLAC, MP3, OGG, OPUS, M4A, MP4 ali WEBM."

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.stanza-tranquilla-se-c"
msgid "Una stanza tranquilla e, se c'è, un microfono a cuffia. Puoi crearla anche per un'altra persona, con il suo permesso."
msgstr "Poišči miren prostor in po možnosti uporabi slušalke z mikrofonom. Glas lahko ustvariš tudi za drugo osebo, če ti to dovoli."

#. {0} is the time recorded so far, a number with one decimal («3,2»): the unit is seconds
#. Placeholders: {} or {0} {1}… are the arguments, in order; {n} is the count of a plural. Leave them as they are; a translation may reorder them.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint, python-brace-format
msgctxt "programma.crea.secondi"
msgid "{} s"
msgstr "{} s"

#. A label over the menu where the person picks the microphone to record with.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.microfono"
msgid "Microfono"
msgstr "Mikrofon"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.apro-microfono"
msgid "Apro il microfono…"
msgstr "Odpiram mikrofon…"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.controllo-registrazione"
msgid "Controllo la registrazione…"
msgstr "Preverjam posnetek…"

#. The instruction over the round record button before recording: press it and read the text below aloud. Short.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.premi-tondo-leggi"
msgid "Premi il tondo e leggi"
msgstr "Pritisni krog in začni brati"

#. While the voice is recorded: {0} is the time recorded so far («3,2 s»); {n} is how many whole seconds of clear voice are still needed
#. Placeholders: {} or {0} {1}… are the arguments, in order; {n} is the count of a plural. Leave them as they are; a translation may reorder them.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint, python-brace-format
msgctxt "programma.crea.mancano"
msgid "{0} · ne manca {n}"
msgid_plural "{0} · ne mancano {n}"
msgstr[0] "{0} · manjka še {n} sekunda"
msgstr[1] "{0} · manjkata še {n} sekundi"
msgstr[2] "{0} · manjkajo še {n} sekunde"
msgstr[3] "{0} · manjka še {n} sekund"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.basta-cosi-premi-nuovo"
msgid "Basta così: premi di nuovo per fermare."
msgstr "Dovolj je. Znova pritisni za konec snemanja."

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.ne-bastano-dodici-secondi"
msgid "Ne bastano dodici secondi di voce: il cerchio si riempie. Il livello si muove con la tua voce."
msgstr "Dvanajst sekund govora je dovolj, da se krog napolni. Med govorom se premika tudi kazalnik glasnosti."

#. A button that stops playing the recording.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.ferma-ascolto"
msgid "Ferma l'ascolto"
msgstr "Ustavi predvajanje"

#. A button that plays the recording just made.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.ascolta-registrazione"
msgid "Ascolta la registrazione"
msgstr "Poslušaj posnetek"

#. A button that throws the recording away to record again. A verb, short.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.rifai"
msgid "Rifai"
msgstr "Poskusi znova"

#. After a recording is read: {n} is how many stretches with a voice were found
#. Placeholders: {} or {0} {1}… are the arguments, in order; {n} is the count of a plural. Leave them as they are; a translation may reorder them.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint, python-brace-format
msgctxt "programma.crea.trovati-tratti"
msgid "Ho trovato {n} tratto in cui si sente la voce. Ascolta e scegli."
msgid_plural "Ho trovato {n} tratti in cui si sente la voce. Ascolta e scegli."
msgstr[0] "Našla sem {n} odlomek, kjer se sliši glas. Poslušaj ga in izberi."
msgstr[1] "Našla sem {n} odlomka, kjer se sliši glas. Poslušaj ju in izberi."
msgstr[2] "Našla sem {n} odlomke, kjer se sliši glas. Poslušaj jih in izberi."
msgstr[3] "Našla sem {n} odlomkov, kjer se sliši glas. Poslušaj jih in izberi."

#. While a voice is made: {} is the name the person gave it
#. Placeholders: {} or {0} {1}… are the arguments, in order; {n} is the count of a plural. Leave them as they are; a translation may reorder them.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint, python-brace-format
msgctxt "programma.crea.creo-voce"
msgid "Creo la voce «{}»…"
msgstr "Ustvarjam glas »{}«…"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.ci-vuole-poco-quando"
msgid "Ci vuole poco. Quando è pronta la scegli da sola."
msgstr "Še malo. Ko bo glas pripravljen, ga izberem samodejno."

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.come-si-chiama-questa"
msgid "Come si chiama questa voce?"
msgstr "Kako želiš poimenovati ta glas?"

#. The name of the field where the person writes the name of the new voice, read by screen readers.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.nome-voce"
msgid "Nome della voce"
msgstr "Ime glasu"

#. An example of a name in the empty field: a name of a person, not a sentence
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.segnaposto-nome-voce"
msgid "Per esempio: la voce di Anna"
msgstr "Na primer: Anin glas"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.mia-voce-oppure-persona"
msgid "È la mia voce, oppure la persona che parla mi ha dato il permesso di usarla."
msgstr "To je moj glas ali pa mi je oseba na posnetku dovolila, da uporabim njen glas."

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.ciao-sono-io-questa"
msgid "Ciao, sono io. Questa è la mia voce, per le riunioni e per le persone a cui voglio bene. La leggo con calma, come parlo ogni giorno."
msgstr "Živjo, tukaj sem. To je moj glas za sestanke in za ljudi, ki mi veliko pomenijo. Berem v miru, tako kot govorim vsak dan."

#. A button at the top of the steps of creating a voice: it leaves them and goes back to the main window, where the person writes the sentences to say. It means «back to writing», not «write again».
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.torna-a-scrivere"
msgid "Torna a scrivere"
msgstr "Nazaj k pisanju"

#. The title of the first step of creating a voice: how the person wants to create it.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.titolo-scegli"
msgid "Come vuoi creare la tua voce?"
msgstr "Kako želiš ustvariti svoj glas?"

#. The title of the step where the person reads a text aloud, calmly.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.titolo-leggi"
msgid "Leggi ad alta voce, con calma"
msgstr "Beri na glas, brez naglice"

#. The title of the last step: listen to the voice and give it a name («la» is the voice).
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.titolo-nome"
msgid "Ascoltala e dalle un nome"
msgstr "Poslušaj glas in ga poimenuj"

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.questa-registrazione-non-si"
msgid "Da questa registrazione non si può creare la voce: rifai."
msgstr "Iz tega posnetka ne morem ustvariti glasu. Poskusi znova."

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.manca-nome"
msgid "Manca il nome."
msgstr "Manjka ime."

#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.manca-permesso-spunta-casella"
msgid "Manca il permesso: spunta la casella."
msgstr "Manjka dovoljenje. Označi polje."

#. The last button of the steps: it creates the voice with the name given.
#: crates/app/ui/kalliope/voce-propria.slint
#, kalliope-slint
msgctxt "programma.crea.crea-voce"
msgid "Crea la voce"
msgstr "Ustvari glas"

#. A warning: the person cannot hear their own voice from the loudspeakers (the option «Senti anche tu la voce»)
#: crates/app/src/audio.rs
#, kalliope-rust
msgctxt "programma.audio.casse"
msgid "Attenzione: non riesco a farti sentire la voce dalle casse."
msgstr "Opozorilo: glasu ne morem predvajati prek zvočnikov."

#: crates/app/src/audio.rs
#, kalliope-rust
msgctxt "programma.audio.serve-pipewire"
msgid "La voce è pronta, ma il microfono «Kalliope» ha bisogno di PipeWire, che su questo computer manca o è troppo vecchio (pacchetti pipewire e pipewire-pulse): per ora nessuno ti sentirà nelle chiamate."
msgstr "Glas je pripravljen, vendar mikrofon »Kalliope« potrebuje PipeWire. Na tem računalniku ga ni ali pa je prestar (paketa pipewire in pipewire-pulse). Za zdaj te v klicih nihče ne bo slišal."

#: crates/app/src/audio.rs
#, kalliope-rust
msgctxt "programma.audio.sistema-non-supportato"
msgid "La voce è pronta, ma su questo sistema il microfono «Kalliope» non c'è ancora: per ora nessuno ti sentirà nelle chiamate."
msgstr "Glas je pripravljen, vendar za ta sistem še ni mikrofona »Kalliope«. Za zdaj te v klicih nihče ne bo slišal."

#: crates/app/src/audio.rs
#, kalliope-rust
msgctxt "programma.audio.pipewire-non-risponde"
msgid "La voce è pronta, ma PipeWire, il servizio audio del computer, non risponde (riprovo da sola appena torna): per ora nessuno ti sentirà nelle chiamate."
msgstr "Glas je pripravljen, vendar se PipeWire, zvočna storitev računalnika, ne odziva. Ko bo spet na voljo, bom poskusila znova. Za zdaj te v klicih nihče ne bo slišal."

#: crates/app/src/audio.rs
#, kalliope-rust
msgctxt "programma.audio.microfono-non-aperto"
msgid "La voce è pronta, ma il microfono «Kalliope» non si è aperto: per ora nessuno ti sentirà nelle chiamate."
msgstr "Glas je pripravljen, vendar mi ni uspelo odpreti mikrofona »Kalliope«. Za zdaj te v klicih nihče ne bo slišal."

#: crates/app/src/catalog.rs
#, kalliope-rust
msgctxt "programma.voce.file-mancanti"
msgid "Non trovo i file della voce, e senza non posso parlare. Reinstalla Kalliope dal pacchetto."
msgstr "Ne najdem datotek za glas. Brez njih ne morem govoriti. Znova namesti Kalliope iz paketa."

#. The title of the system's window for choosing an audio or video file
#: crates/app/src/collega.rs
#, kalliope-rust
msgctxt "programma.scelta.titolo"
msgid "Scegli una registrazione"
msgstr "Izberi posnetek"

#. A filter in the system's window for choosing a file: only audio and video files.
#: crates/app/src/collega.rs
#, kalliope-rust
msgctxt "programma.scelta.audio-e-video"
msgid "Audio e video"
msgstr "Zvok in video"

#. A filter in the system's window for choosing a file: every file.
#: crates/app/src/collega.rs
#, kalliope-rust
msgctxt "programma.scelta.tutti-i-file"
msgid "Tutti i file"
msgstr "Vse datoteke"

#: crates/app/src/crea.rs
#, kalliope-rust
msgctxt "programma.crea.non-ti-sento"
msgid "Non ti sento. Avvicinati al microfono, controlla che non sia spento, o scegline un altro."
msgstr "Ne slišim te. Približaj se mikrofonu, preveri, ali je vklopljen, ali pa izberi drugega."

#: crates/app/src/crea.rs
#, kalliope-rust
msgctxt "programma.crea.troppo-forte"
msgid "Il suono è troppo forte: allontanati un po' dal microfono."
msgstr "Zvok je preglasen. Malo se odmakni od mikrofona."

#: crates/app/src/crea.rs
#, kalliope-rust
msgctxt "programma.crea.serve-permesso"
msgid "Per continuare serve il permesso: spunta la casella."
msgstr "Za nadaljevanje potrebujem dovoljenje. Označi polje."

#. The first stretch of a recording, the one where the voice is clearest: {numero} is its number
#. Placeholders to leave as they are: {numero}
#: crates/app/src/crea.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.crea.tratto-chiaro"
msgid "Tratto {numero} · il più chiaro"
msgstr "Odlomek {numero} · najrazločnejši"

#. The name of a stretch of an imported recording where a voice was found, numbered: «Stretch 2». {numero} is the number.
#. Placeholders to leave as they are: {numero}
#: crates/app/src/crea.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.crea.tratto"
msgid "Tratto {numero}"
msgstr "Odlomek {numero}"

#. A stretch of a recording: from {inizio} to {fine} (times like 0:12), with {secondi} seconds of voice
#. Placeholders to leave as they are: {inizio} {fine} {secondi}
#: crates/app/src/crea.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.crea.tratto-dettaglio"
msgid "da {inizio} a {fine} · {secondi} s di voce"
msgstr "od {inizio} do {fine} · {secondi} s govora"

#: crates/app/src/crea.rs
#, kalliope-rust
msgctxt "programma.crea.scelta-file-non-si-apre"
msgid "Non si apre la finestra per scegliere il file. Riprova; se succede ancora, serve il portale del tuo desktop o il programma «zenity»."
msgstr "Okno za izbiro datoteke se ne odpre. Poskusi znova. Če se to ponovi, potrebuješ portal svojega namiznega okolja ali program »zenity«."

#: crates/app/src/crea.rs
#, kalliope-rust
msgctxt "programma.crea.tratto-inutilizzabile"
msgid "Da questo tratto non si può creare la voce: scegli un altro tratto, o rifai."
msgstr "Iz tega odlomka ne morem ustvariti glasu. Izberi drugega ali poskusi znova."

#. A button: replace the existing voice that has the same name with the new one.
#: crates/app/src/crea.rs
#, kalliope-rust
msgctxt "programma.crea.sostituisci-voce"
msgid "Sostituisci la voce"
msgstr "Zamenjaj glas"

#. A button: keep this name, although one of Kalliope's own voices has it too.
#: crates/app/src/crea.rs
#, kalliope-rust
msgctxt "programma.crea.tieni-nome"
msgid "Tieni questo nome"
msgstr "Obdrži to ime"

#. Placeholders to leave as they are: {nome}
#: crates/app/src/crea.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.crea.voce-pronta"
msgid "La voce «{nome}» è pronta, e adesso parla lei."
msgstr "Glas »{nome}« je pripravljen. Zdaj govoriš z njim."

#. In the voice menu: a voice made from a recording that has the same name as one of Kalliope's («Giulia (voce propria)»); {nome} is that name
#. Placeholders to leave as they are: {nome}
#: crates/app/src/engine.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.voci.voce-propria"
msgid "{nome} (voce propria)"
msgstr "{nome} (lastni glas)"

#. {voce} is the voice that failed, {altra} the one that speaks instead
#. Placeholders to leave as they are: {voce} {altra}
#: crates/app/src/engine.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.motore.voce-non-si-apre-parlo-con"
msgid "La voce «{voce}» non si apre: parlo con {altra}. Puoi sceglierne un'altra dal menu «Voce»."
msgstr "Glasu »{voce}« ne morem odpreti. Govorim z glasom »{altra}«. V meniju »Glas« lahko izbereš drugega."

#. Placeholders to leave as they are: {voce} {altra}
#: crates/app/src/engine.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.motore.voce-non-si-apre-continuo"
msgid "La voce «{voce}» non si apre: continuo con «{altra}»."
msgstr "Glasu »{voce}« ne morem odpreti. Nadaljujem z glasom »{altra}«."

#. {causa} is the system's own message, in English: it stays as it is
#. Placeholders to leave as they are: {causa}
#: crates/app/src/engine.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.motore.frase-non-detta"
msgid "Non sono riuscita a dire questa frase: {causa}"
msgstr "Te povedi mi ni uspelo izgovoriti: {causa}"

#. {causa} is the system's own message, in English: it stays as it is
#. Placeholders to leave as they are: {causa}
#: crates/app/src/engine.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.motore.non-prepara"
msgid "Non riesco a preparare la voce: {causa}"
msgstr "Glasu ne morem pripraviti: {causa}"

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.registra.nessun-microfono"
msgid "Non trovo un microfono. Collegane uno (meglio una cuffia con microfono), poi riprova."
msgstr "Ne najdem mikrofona. Priključi ga in poskusi znova. Najbolje se obnesejo slušalke z mikrofonom."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.registra.serve-pipewire"
msgid "Su questo computer non posso registrare: serve PipeWire, il servizio audio dei sistemi Linux di oggi."
msgstr "Na tem računalniku ne morem snemati. Potrebujem PipeWire, zvočno storitev sodobnih sistemov Linux."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.registra.audio-non-risponde"
msgid "Il servizio audio del computer non risponde: riprova fra qualche secondo."
msgstr "Zvočna storitev računalnika se ne odziva. Čez nekaj sekund poskusi znova."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.registra.microfono-non-aperto"
msgid "Il microfono non si è aperto. Riprova, o scegli un altro microfono."
msgstr "Mikrofona ni bilo mogoče odpreti. Poskusi znova ali izberi drug mikrofon."

#. Placeholders to leave as they are: {n}
#: crates/app/src/own_voice.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.file.lungo"
msgid "Il file è lungo: ho cercato la voce nel primo minuto."
msgid_plural "Il file è lungo: ho cercato la voce nei primi {n} minuti."
msgstr[0] "Posnetek je dolg. Od začetka posnetka sem pregledala {n} minuto in v tem delu iskala glas."
msgstr[1] "Posnetek je dolg. Od začetka posnetka sem pregledala {n} minuti in v tem delu iskala glas."
msgstr[2] "Posnetek je dolg. Od začetka posnetka sem pregledala {n} minute in v tem delu iskala glas."
msgstr[3] "Posnetek je dolg. Od začetka posnetka sem pregledala {n} minut in v tem delu iskala glas."

#. Placeholders to leave as they are: {label}
#: crates/app/src/own_voice.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.registra.scollegato"
msgid "Il microfono «{label}» si è scollegato: tengo quello che hai registrato fino a quel momento."
msgstr "Povezava z mikrofonom »{label}« se je prekinila. Dosedanji posnetek sem obdržala."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.registra.nessun-suono"
msgid "Non è arrivato nessun suono dal microfono. Controlla che sia collegato e acceso, poi riprova."
msgstr "Iz mikrofona ni prišel noben zvok. Preveri, ali je priključen in vklopljen, nato poskusi znova."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.nome.vuoto"
msgid "Scrivi un nome per la voce, per esempio «La voce di Anna»."
msgstr "Vnesi ime glasu, na primer »Anin glas«."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.nome.troppo-lungo"
msgid "Il nome è troppo lungo: accorcialo un po'."
msgstr "Ime je predolgo. Malo ga skrajšaj."

#. {nome} is a name the person typed that is also the name of Giulia or Marco
#. Placeholders to leave as they are: {nome}
#: crates/app/src/own_voice.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.nome.come-una-voce-di-kalliope"
msgid "«{nome}» è anche il nome di una voce di Kalliope. Puoi tenerlo: nel menu la tua comparirà come «{nome} (voce propria)». Oppure scegli un altro nome."
msgstr "»{nome}« je tudi ime enega od glasov Kalliope. Ime lahko obdržiš. Tvoj glas bo v meniju prikazan kot »{nome} (lastni glas)«. Lahko pa izbereš drugo ime."

#. Placeholders to leave as they are: {nome}
#: crates/app/src/own_voice.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.nome.esiste"
msgid "C'è già una voce che si chiama «{nome}». Vuoi sostituirla con questa, o preferisci un altro nome?"
msgstr "Glas z imenom »{nome}« že obstaja. Ga želiš zamenjati s tem ali izbrati drugo ime?"

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.voce.registrazione-non-basta"
msgid "Questa registrazione non basta per creare una voce."
msgstr "Ta posnetek ne zadošča za ustvarjanje glasu."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.voce.non-creata"
msgid "Non sono riuscita a creare la voce. Riprova; se succede ancora, prova con un'altra registrazione."
msgstr "Glasu mi ni uspelo ustvariti. Poskusi znova. Če se to ponovi, poskusi z drugim posnetkom."

#: crates/app/src/own_voice.rs
#, kalliope-rust
msgctxt "programma.registra.casse"
msgid "Non riesco a farti ascoltare la registrazione dalle casse."
msgstr "Posnetka ne morem predvajati prek zvočnikov."

#. The status line when the voice is ready; «Kalliope» is the name of the virtual microphone the person picks in the meeting
#: crates/app/src/session.rs
#, kalliope-rust
msgctxt "programma.sessione.pronta"
msgid "Pronta. In Zoom, Teams, Meet o nel browser scegli «Kalliope» come microfono."
msgstr "Pripravljena. V aplikaciji Zoom, Teams, Meet ali v brskalniku za mikrofon izberi »Kalliope«."

#: crates/app/src/session.rs
#, kalliope-rust
msgctxt "programma.sessione.parlo"
msgid "Sto parlando…"
msgstr "Govorim…"

#: crates/app/src/session.rs
#, kalliope-rust
msgctxt "programma.sessione.nessuno-sente"
msgid "Nessuno nella chiamata ha sentito la frase: nessuna app sta usando il microfono «Kalliope». Sceglilo come microfono nell'app della riunione."
msgstr "V klicu nihče ni slišal povedi. Nobena aplikacija ne uporablja mikrofona »Kalliope«. Izberi ga za mikrofon v aplikaciji za sestanke."

#: crates/app/src/session.rs
#, kalliope-rust
msgctxt "programma.sessione.nessuno-sente-senza-frase"
msgid "Nessuna app sta usando il microfono «Kalliope». Sceglilo come microfono nell'app della riunione."
msgstr "Nobena aplikacija ne uporablja mikrofona »Kalliope«. Izberi ga za mikrofon v aplikaciji za sestanke."

#: crates/app/src/session.rs
#, kalliope-rust
msgctxt "programma.sessione.niente-da-dire"
msgid "Non c'è niente da dire in questo testo: scrivi almeno una parola, poi premi Invio."
msgstr "V besedilu ni nobene besede, ki bi jo lahko izgovorila. Napiši vsaj eno besedo in pritisni Enter."

#: crates/app/src/session.rs
#, kalliope-rust
msgctxt "programma.sessione.preparo"
msgid "Preparo la voce…"
msgstr "Pripravljam glas…"

#: crates/sample/src/analysis.rs
#, kalliope-rust
msgctxt "programma.analisi.nessuna-voce"
msgid "Non sento una voce che parla: solo silenzio, rumore o musica. Registra di nuovo, o scegli un altro file."
msgstr "Ne slišim govora, le tišino, šum ali glasbo. Posnemi se znova ali izberi drugo datoteko."

#: crates/sample/src/analysis.rs
#, kalliope-rust
msgctxt "programma.analisi.troppo-poco-parlato"
msgid "C'è troppo poco parlato: servono almeno 4 secondi di voce, meglio 12. Registra ancora un po', o scegli un file più lungo."
msgstr "Govora je premalo. Potrebujem vsaj 4 sekunde, še bolje 12. Snemaj malo dlje ali izberi daljšo datoteko."

#: crates/sample/src/analysis.rs
#, kalliope-rust
msgctxt "programma.analisi.parlato-breve"
msgid "La voce si può creare, ma con 12 secondi di parlato somiglierebbe di più alla persona."
msgstr "Glas lahko ustvarim. Z 12 sekundami govora bi bil bolj podoben glasu osebe na posnetku."

#: crates/sample/src/analysis.rs
#, kalliope-rust
msgctxt "programma.analisi.distorta"
msgid "La voce è distorta perché era troppo forte. Allontana un po' il microfono, o abbassane il volume, e registra di nuovo."
msgstr "Glas je bil preglasen, zato je na posnetku popačen. Malo odmakni mikrofon ali zmanjšaj njegovo glasnost in se posnemi znova."

#: crates/sample/src/analysis.rs
#, kalliope-rust
msgctxt "programma.analisi.troppo-bassa"
msgid "La voce è molto bassa. Avvicinati al microfono, o alzane il volume, e registra di nuovo."
msgstr "Glas je zelo tih. Približaj se mikrofonu ali povečaj njegovo glasnost in se posnemi znova."

#: crates/sample/src/analysis.rs
#, kalliope-rust
msgctxt "programma.analisi.rumore-di-fondo"
msgid "C'è molto rumore di fondo, e la voce creata lo imiterà. Se puoi, registra in un posto più silenzioso."
msgstr "V ozadju je veliko hrupa. Slišal se bo tudi v ustvarjenem glasu. Če lahko, se posnemi kje, kjer je tišje."

#: crates/sample/src/analysis.rs
#, kalliope-rust
msgctxt "programma.analisi.musica"
msgid "Questo tratto sembra musica più che una voce che parla. Scegli un altro tratto, o un altro file."
msgstr "V tem odlomku se bolj sliši glasba kot govor. Izberi drug odlomek ali drugo datoteko."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.non-c-e-piu"
msgid "Non riesco ad aprire il file: non c'è più, forse è stato spostato o cancellato. Scegline un altro."
msgstr "Datoteke ne morem odpreti, ker je ni več. Morda je bila premaknjena ali izbrisana. Izberi drugo."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.nessun-permesso"
msgid "Non riesco ad aprire il file: non ho il permesso di leggerlo. Scegline un altro."
msgstr "Datoteke ne morem odpreti. Nimam dovoljenja za branje. Izberi drugo."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.non-si-apre"
msgid "Non riesco ad aprire il file: non si apre. Scegline un altro."
msgstr "Datoteke ne morem odpreti. Izberi drugo."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.vuoto"
msgid "Il file è vuoto."
msgstr "Datoteka je prazna."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.non-audio"
msgid "Questo file non è un audio. Prova con un messaggio vocale, un video o una registrazione."
msgstr "To ni zvočna datoteka. Poskusi z glasovnim sporočilom, videom ali zvočnim posnetkom."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.senza-audio"
msgid "In questo file non c'è audio."
msgstr "V tej datoteki ni zvoka."

#. {formato} is the audio format the file has
#. Placeholders to leave as they are: {formato}
#: crates/sample/src/decode.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.file.non-supportato"
msgid "Kalliope non sa ancora leggere l'audio di questo file ({formato}). Convertilo in WAV o MP3, oppure scegline un altro."
msgstr "Kalliope še ne zna prebrati zvoka v tej datoteki ({formato}). Pretvori jo v WAV ali MP3 ali izberi drugo."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.manca-libopus"
msgid "Per leggere i messaggi vocali in formato Opus serve la libreria libopus, che su questo computer manca: installa il pacchetto «opus» (o «libopus0»)."
msgstr "Za branje glasovnih sporočil v obliki Opus potrebujem knjižnico libopus. Na tem računalniku je ni. Namesti paket »opus« (ali »libopus0«)."

#. Placeholders to leave as they are: {causa}
#: crates/sample/src/decode.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.file.rovinato"
msgid "Il file sembra rovinato e non si legge ({causa})."
msgstr "Datoteka je verjetno poškodovana in je ne morem prebrati ({causa})."

#: crates/sample/src/decode.rs
#, kalliope-rust
msgctxt "programma.file.lettura-annullata"
msgid "Lettura annullata."
msgstr "Branje je preklicano."

#: crates/sample/src/lib.rs
#, kalliope-rust
msgctxt "programma.voce.creazione-annullata"
msgid "Creazione della voce annullata."
msgstr "Ustvarjanje glasu je preklicano."

#. Placeholders to leave as they are: {causa}
#: crates/sample/src/lib.rs
#, kalliope-rust, python-brace-format
msgctxt "programma.voce.creazione-fallita"
msgid "Non sono riuscita a creare la voce: {causa}"
msgstr "Glasu mi ni uspelo ustvariti: {causa}"

